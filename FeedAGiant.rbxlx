          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Arena</string>
              <string name="Source"><![CDATA[--!strict
-- Arena.lua — janela "GIANT CLASH": lista jogadores para desafiar, popup de desafio recebido, overlay da luta com barras de HP.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)

local Arena = {}
local player = Players.LocalPlayer
local win: Frame
local listFrame: Frame
local challengePopup: Frame
local challengeText: TextLabel
local fight: Frame
local nameA: TextLabel
local nameB: TextLabel
local hpA: Frame
local hpB: Frame
local fightTitle: TextLabel
local pendingFrom = 0
Arena.playSound = nil :: ((string, number?) -> ())?
Arena.shake = nil :: ((number, number) -> ())?

local function sfx(k: string, v: number?)
	if Arena.playSound then
		Arena.playSound(k, v)
	end
end

local function rebuildList()
	for _, c in listFrame:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local n = 0
	for _, p in Players:GetPlayers() do
		if p == player then
			continue
		end
		n += 1
		local row = UI.frame(listFrame, { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = UI.Colors.Panel })
		UI.label(row, p.DisplayName, { Size = UDim2.new(1, -170, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left })
		local b = UI.button(row, "DESAFIAR ⚔", UI.Colors.Red, { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -158, 0.5, -20) })
		b.MouseButton1Click:Connect(function()
			Remotes.RequestDuel:FireServer(p.UserId)
		end)
	end
	if n == 0 then
		UI.label(listFrame, "Nenhum oponente no servidor. Convide amigos!", { Size = UDim2.new(1, 0, 0, 40), TextColor3 = UI.Colors.Accent })
	end
end

local function statsText(s: State.PlayerState): string
	local a = s :: any
	local cd = math.max(0, (a.lastDuel or 0) + (if s.passes.ArenaVIP then Config.Arena.DuelCooldown / 2 else Config.Arena.DuelCooldown) - os.time())
	return string.format("Vitórias %d  •  Derrotas %d  •  %s", a.arenaWins or 0, a.arenaLosses or 0, if cd > 0 then "Cooldown " .. cd .. "s" else "Pronto para lutar!")
end

local function buildWindow(gui: ScreenGui)
	local body: Frame
	win, body = UI.window(gui, "GIANT CLASH — ARENA", UDim2.fromOffset(520, 460))
	local stats = UI.label(body, "", { Size = UDim2.new(1, 0, 0, 24), TextColor3 = UI.Colors.Accent })
	UI.label(body, "Vencedor rouba as 2 comidas mais raras do PÁTIO do perdedor + 5% das moedas. Força = espécie × nível × rebirth × humor (+sorte).", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 26), TextScaled = false, TextSize = 13, TextWrapped = true, TextTransparency = 0.2 })
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, -76)
	scroll.Position = UDim2.fromOffset(0, 72)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = body
	listFrame = UI.frame(scroll, { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
	local lay = Instance.new("UIListLayout")
	lay.Padding = UDim.new(0, 6)
	lay.Parent = listFrame
	State.onChanged(function(s)
		stats.Text = statsText(s)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if win.Visible then
				stats.Text = statsText(State.current)
			end
		end
	end)
end

local function buildPopup(gui: ScreenGui)
	challengePopup = UI.frame(gui, { Size = UDim2.fromOffset(420, 150), Position = UDim2.new(0.5, 0, 0.25, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = UI.Colors.Bg, Visible = false })
	UI.stroke(challengePopup, UI.Colors.Red, 3)
	challengeText = UI.label(challengePopup, "", { Size = UDim2.new(1, -20, 0, 70), Position = UDim2.fromOffset(10, 8), TextWrapped = true })
	local acc = UI.button(challengePopup, "ACEITAR ⚔", UI.Colors.Green, { Size = UDim2.fromOffset(180, 48), Position = UDim2.fromOffset(20, 90) })
	local dec = UI.button(challengePopup, "RECUSAR", Color3.fromRGB(110, 110, 130), { Size = UDim2.fromOffset(180, 48), Position = UDim2.fromOffset(220, 90) })
	acc.MouseButton1Click:Connect(function()
		Remotes.RequestDuelAnswer:FireServer(pendingFrom, true)
		challengePopup.Visible = false
	end)
	dec.MouseButton1Click:Connect(function()
		Remotes.RequestDuelAnswer:FireServer(pendingFrom, false)
		challengePopup.Visible = false
	end)
end

local function buildFight(gui: ScreenGui)
	fight = UI.frame(gui, { Name = "FightOverlay", Size = UDim2.fromOffset(620, 110), Position = UDim2.new(0.5, 0, 0, 100), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = UI.Colors.Bg, BackgroundTransparency = 0.1, Visible = false })
	UI.stroke(fight, UI.Colors.Accent, 3)
	fightTitle = UI.label(fight, "⚔ GIANT CLASH ⚔", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 4), TextColor3 = UI.Colors.Accent })
	nameA = UI.label(fight, "", { Size = UDim2.fromOffset(280, 24), Position = UDim2.fromOffset(12, 36), TextXAlignment = Enum.TextXAlignment.Left })
	nameB = UI.label(fight, "", { Size = UDim2.fromOffset(280, 24), Position = UDim2.new(1, -292, 0, 36), TextXAlignment = Enum.TextXAlignment.Right })
	local bgA = UI.frame(fight, { Size = UDim2.fromOffset(280, 22), Position = UDim2.fromOffset(12, 68), BackgroundColor3 = Color3.fromRGB(20, 20, 30) })
	UI.corner(bgA, 11)
	hpA = UI.frame(bgA, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.Colors.Green })
	UI.corner(hpA, 11)
	local bgB = UI.frame(fight, { Size = UDim2.fromOffset(280, 22), Position = UDim2.new(1, -292, 0, 68), BackgroundColor3 = Color3.fromRGB(20, 20, 30) })
	UI.corner(bgB, 11)
	hpB = UI.frame(bgB, { Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), BackgroundColor3 = UI.Colors.Red })
	UI.corner(hpB, 11)
	UI.label(fight, "VS", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0.5, -20, 0, 50), TextColor3 = UI.Colors.Accent })
end

function Arena.open()
	rebuildList()
	UI.pop(win)
end

function Arena.init(gui: ScreenGui)
	buildWindow(gui)
	buildPopup(gui)
	buildFight(gui)
	Players.PlayerAdded:Connect(function()
		if win.Visible then
			rebuildList()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if win.Visible then
			rebuildList()
		end
	end)

	Remotes.ArenaState.OnClientEvent:Connect(function(e)
		if type(e) ~= "table" then
			return
		end
		if e.kind == "Challenge" then
			pendingFrom = e.from
			challengeText.Text = string.format("%s te desafiou para o GIANT CLASH!\nForça dele: %d  •  Você perde 2 comidas do pátio se perder.", e.fromName, e.power)
			UI.pop(challengePopup)
			sfx("Bell", 0.8)
			task.delay(20, function()
				if pendingFrom == e.from then
					challengePopup.Visible = false
				end
			end)
		elseif e.kind == "Sent" then
			win.Visible = false
		elseif e.kind == "Declined" then
			-- Notify já cobre; nada
		elseif e.kind == "Start" then
			local involved = e.a == player.UserId or e.b == player.UserId
			fight.Visible = true
			fightTitle.Text = (if e.tournament then "🏆 CAMPEONATO: " else "⚔ GIANT CLASH: ") .. e.aName .. " vs " .. e.bName
			nameA.Text = string.format("%s  (⚡%d)", e.aName, e.powerA)
			nameB.Text = string.format("(⚡%d)  %s", e.powerB, e.bName)
			hpA.Size = UDim2.fromScale(1, 1)
			hpB.Size = UDim2.fromScale(1, 1)
			sfx("Bell", if involved then 1 else 0.5)
			if involved then
				win.Visible = false
			end
		elseif e.kind == "Tick" then
			TweenService:Create(hpA, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(e.hpA / 100, 0, 1), 1) }):Play()
			TweenService:Create(hpB, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(e.hpB / 100, 0, 1), 1) }):Play()
			sfx(if math.random() < 0.3 then "Heavy" else "Punch", 0.4)
			if (e.a == player.UserId or e.b == player.UserId) and Arena.shake then
				Arena.shake(0.6, 0.2)
			end
		elseif e.kind == "End" then
			if e.winner == player.UserId then
				fightTitle.Text = "🏆 VOCÊ VENCEU!" .. (if e.stolen and #e.stolen > 0 then "  Roubou: " .. table.concat(e.stolen, ", ") else "")
				sfx("Win", 1)
			elseif e.a == player.UserId or e.b == player.UserId then
				fightTitle.Text = "💀 Derrota... " .. (e.winnerName or "") .. " venceu."
				sfx("KO", 0.9)
			else
				fightTitle.Text = (e.winnerName or "?") .. " venceu!"
			end
			task.delay(4, function()
				fight.Visible = false
			end)
		elseif e.kind == "Tournament" then
			sfx("Bell", 1)
		end
	end)
end

return Arena
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Combat</string>
              <string name="Source"><![CDATA[--!strict
-- Combat.lua — socos (clique/J), pesado (botão direito/K), bloqueio (F segurado). Mobile: botões na tela.
-- Barra de stamina/HP, hit-marker, screen shake e sons.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)

local Combat = {}
local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local staminaFill: Frame
local hpFill: Frame
local comboLabel: TextLabel
local koLabel: TextLabel
local blockBadge: TextLabel
local blocking = false
local sounds: { [string]: Sound } = {}

local function sound(key: string, volume: number?)
	local s = sounds[key]
	if not s then
		local id = (Config.Sounds :: any)[key]
		if not id or id == 0 then
			return
		end
		s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = volume or 0.6
		s.Parent = SoundService
		sounds[key] = s
	end
	s:Play()
end
Combat.sound = sound

local function shake(intensity: number, duration: number)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - t0) / duration
		if a >= 1 then
			conn:Disconnect()
			return
		end
		local k = intensity * (1 - a)
		camera.CFrame = camera.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end)
end
Combat.shake = shake

local function hitMarker(worldPos: Vector3, text: string, color: Color3)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Transparency = 1
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.CFrame = CFrame.new(worldPos + Vector3.new(math.random(-1, 1), 2, 0))
	part.Parent = Workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 40)
	bb.AlwaysOnTop = true
	bb.Parent = part
	local l = UI.label(bb, text, { Size = UDim2.fromScale(1, 1), TextColor3 = color })
	TweenService:Create(bb, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(0.65, function()
		part:Destroy()
	end)
end

local function rootOfUser(userId: number): BasePart?
	local p = Players:GetPlayerByUserId(userId)
	local c = p and p.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function setBlock(on: boolean)
	if blocking == on then
		return
	end
	blocking = on
	Remotes.RequestBlock:FireServer(on)
end

local function buildBars(gui: ScreenGui)
	local box = UI.frame(gui, {
		Name = "CombatBars",
		Size = UDim2.fromOffset(240, 62),
		Position = UDim2.new(1, -12, 1, -24),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = UI.Colors.Bg,
		BackgroundTransparency = 0.15,
	})
	UI.stroke(box, Color3.new(0, 0, 0), 3)
	UI.label(box, "HP", { Size = UDim2.fromOffset(36, 20), Position = UDim2.fromOffset(8, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Red })
	local hpBg = UI.frame(box, { Size = UDim2.fromOffset(180, 16), Position = UDim2.fromOffset(50, 8), BackgroundColor3 = Color3.fromRGB(20, 20, 30) })
	UI.corner(hpBg, 8)
	hpFill = UI.frame(hpBg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.Colors.Red })
	UI.corner(hpFill, 8)
	UI.label(box, "STA", { Size = UDim2.fromOffset(36, 20), Position = UDim2.fromOffset(8, 34), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Accent })
	local stBg = UI.frame(box, { Size = UDim2.fromOffset(180, 16), Position = UDim2.fromOffset(50, 36), BackgroundColor3 = Color3.fromRGB(20, 20, 30) })
	UI.corner(stBg, 8)
	staminaFill = UI.frame(stBg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.Colors.Accent })
	UI.corner(staminaFill, 8)
	blockBadge = UI.label(box, "🛡 BLOQUEANDO", { Size = UDim2.fromOffset(160, 20), Position = UDim2.fromOffset(40, -24), TextColor3 = UI.Colors.Blue, Visible = false })
	comboLabel = UI.label(gui, "", { Size = UDim2.fromOffset(240, 50), Position = UDim2.new(0.5, 0, 0.3, 0), AnchorPoint = Vector2.new(0.5, 0.5), TextColor3 = UI.Colors.Accent, Visible = false })
	koLabel = UI.label(gui, "K.O.!", { Size = UDim2.fromOffset(400, 90), Position = UDim2.new(0.5, 0, 0.42, 0), AnchorPoint = Vector2.new(0.5, 0.5), TextColor3 = UI.Colors.Red, Visible = false })
	local hint = UI.label(gui, "Clique/J: soco  •  Dir./K: pesado  •  F: bloquear  (zona segura no seu pátio)", { Size = UDim2.fromOffset(460, 18), Position = UDim2.new(1, -12, 1, -92), AnchorPoint = Vector2.new(1, 1), TextScaled = false, TextSize = 12, TextTransparency = 0.3, TextXAlignment = Enum.TextXAlignment.Right })
	hint.Visible = not UserInputService.TouchEnabled
end

local function buildMobile(gui: ScreenGui)
	if not UserInputService.TouchEnabled then
		return
	end
	local pad = UI.frame(gui, { Name = "MobileCombat", Size = UDim2.fromOffset(190, 190), Position = UDim2.new(1, -16, 1, -100), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1 })
	local punch = UI.button(pad, "👊", UI.Colors.Accent, { Size = UDim2.fromOffset(84, 84), Position = UDim2.fromOffset(100, 100) })
	UI.corner(punch, 42)
	local heavy = UI.button(pad, "💥", UI.Colors.Red, { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(10, 110) })
	UI.corner(heavy, 35)
	local block = UI.button(pad, "🛡", UI.Colors.Blue, { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(110, 10) })
	UI.corner(block, 35)
	punch.MouseButton1Click:Connect(function()
		Remotes.RequestPunch:FireServer(false)
	end)
	heavy.MouseButton1Click:Connect(function()
		Remotes.RequestPunch:FireServer(true)
	end)
	block.MouseButton1Down:Connect(function()
		setBlock(true)
	end)
	block.MouseButton1Up:Connect(function()
		setBlock(false)
	end)
	block.MouseLeave:Connect(function()
		setBlock(false)
	end)
end

local function bindInput()
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.J then
			Remotes.RequestPunch:FireServer(false)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.K then
			Remotes.RequestPunch:FireServer(true)
		elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonL1 then
			setBlock(true)
		elseif input.KeyCode == Enum.KeyCode.ButtonR1 then
			Remotes.RequestPunch:FireServer(false)
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			Remotes.RequestPunch:FireServer(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonL1 then
			setBlock(false)
		end
	end)
end

function Combat.init(gui: ScreenGui)
	buildBars(gui)
	buildMobile(gui)
	bindInput()

	Remotes.CombatState.OnClientEvent:Connect(function(s)
		if type(s) ~= "table" then
			return
		end
		TweenService:Create(staminaFill, TweenInfo.new(0.15), { Size = UDim2.fromScale(math.clamp(s.stamina / math.max(1, s.maxStamina), 0, 1), 1) }):Play()
		TweenService:Create(hpFill, TweenInfo.new(0.15), { Size = UDim2.fromScale(math.clamp(s.hp / math.max(1, s.maxHp), 0, 1), 1) }):Play()
		blockBadge.Visible = s.blocking == true
		blocking = s.blocking == true
		if s.combo and s.combo >= 2 then
			comboLabel.Text = "COMBO x" .. s.combo .. "!"
			comboLabel.Visible = true
			UI.pop(comboLabel)
		else
			comboLabel.Visible = false
		end
		koLabel.Visible = s.ko == true
	end)

	Remotes.CombatEvent.OnClientEvent:Connect(function(e)
		if type(e) ~= "table" then
			return
		end
		if e.kind == "Hit" then
			local vroot = rootOfUser(e.victim)
			if vroot then
				hitMarker(vroot.Position, if e.blocked then "BLOQUEADO" else (if e.heavy then "PESADO!" else "HIT"), if e.blocked then UI.Colors.Blue else (if e.heavy then UI.Colors.Red else UI.Colors.Accent))
			end
			sound(if e.blocked then "Block" elseif e.heavy then "Heavy" else "Punch")
			if e.victim == player.UserId then
				shake(if e.heavy then 1.2 else 0.5, 0.25)
			elseif e.attacker == player.UserId then
				shake(0.25, 0.12)
			end
		elseif e.kind == "KO" then
			sound("KO", 0.9)
			local vroot = rootOfUser(e.victim)
			if vroot then
				hitMarker(vroot.Position, "K.O.!", UI.Colors.Red)
			end
			if e.victim == player.UserId then
				shake(2.5, 0.6)
			end
		elseif e.kind == "Impact" then
			sound("Impact", 0.8)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and typeof(e.pos) == "Vector3" then
				local d = (root.Position - e.pos).Magnitude
				shake(math.clamp(3 - d / 40, 0.2, 3), 0.5)
			end
		end
	end)
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Drops</string>
              <string name="Source"><![CDATA[--!strict
-- Drops.lua — painel lateral "DISPUTA" com os contendores de cada drop ativo + seta até o drop mais próximo.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)

local Drops = {}
local player = Players.LocalPlayer
local panel: Frame
local list: Frame
local cards: { [number]: Frame } = {}
local drops: { [number]: any } = {}
local arrow: TextLabel

local function rebuildCard(d: any)
	local card = cards[d.id]
	if not card then
		card = UI.frame(list, { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = UI.Colors.Panel })
		UI.stroke(card, Config.Rarities[d.rarity].color, 2)
		local title = UI.label(card, "", { Name = "Title", Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(6, 2), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Rarities[d.rarity].color })
		title.Text = d.name .. " (" .. d.rarity .. ") — segure " .. d.holdTime .. "s"
		local rows = UI.frame(card, { Name = "Rows", Size = UDim2.new(1, -12, 1, -26), Position = UDim2.fromOffset(6, 24), BackgroundTransparency = 1 })
		local lay = Instance.new("UIListLayout")
		lay.Padding = UDim.new(0, 2)
		lay.Parent = rows
		cards[d.id] = card
	end
	local rows = card:FindFirstChild("Rows") :: Frame
	for _, c in rows:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local n = 0
	for i, c in d.contenders or {} do
		if i > 4 then
			break
		end
		n += 1
		local row = UI.frame(rows, { Size = UDim2.new(1, 0, 0, 16), BackgroundColor3 = Color3.fromRGB(20, 20, 30) })
		UI.corner(row, 6)
		local fill = UI.frame(row, { Size = UDim2.fromScale(math.clamp(c.progress, 0, 1), 1), BackgroundColor3 = if c.userId == player.UserId then UI.Colors.Green else (if c.inside then UI.Colors.Accent else Color3.fromRGB(110, 110, 130)) })
		UI.corner(fill, 6)
		UI.label(row, string.format("%s %d%%", c.name, math.floor(c.progress * 100)), { Size = UDim2.fromScale(1, 1), TextScaled = false, TextSize = 11 })
	end
	if n == 0 then
		UI.label(rows, "Ninguém no círculo — CORRA!", { Size = UDim2.new(1, 0, 0, 16), TextScaled = false, TextSize = 11, TextColor3 = UI.Colors.Accent })
		n = 1
	end
	card.Size = UDim2.new(1, 0, 0, 30 + n * 18)
end

local function refreshPanel()
	local any = next(drops) ~= nil
	panel.Visible = any
	arrow.Visible = any
end

function Drops.init(gui: ScreenGui)
	panel = UI.frame(gui, { Name = "DropsPanel", Size = UDim2.fromOffset(280, 220), Position = UDim2.new(1, -12, 0, 12), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = UI.Colors.Bg, BackgroundTransparency = 0.1, Visible = false })
	UI.stroke(panel, Color3.new(0, 0, 0), 3)
	UI.label(panel, "⚔ DISPUTA DE COMIDA", { Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Accent })
	list = UI.frame(panel, { Size = UDim2.new(1, -16, 1, -36), Position = UDim2.fromOffset(8, 32), BackgroundTransparency = 1 })
	local lay = Instance.new("UIListLayout")
	lay.Padding = UDim.new(0, 6)
	lay.Parent = list
	arrow = UI.label(gui, "▼ COMIDA CAINDO NO CENTRO ▼", { Size = UDim2.fromOffset(360, 30), Position = UDim2.new(0.5, 0, 0, 100), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = UI.Colors.Accent, Visible = false })

	Remotes.DropState.OnClientEvent:Connect(function(d)
		if type(d) ~= "table" or type(d.id) ~= "number" then
			return
		end
		if d.removed then
			drops[d.id] = nil
			if cards[d.id] then
				cards[d.id]:Destroy()
				cards[d.id] = nil
			end
		else
			drops[d.id] = d
			rebuildCard(d)
		end
		refreshPanel()
	end)

	-- Seta aponta para o drop mais próximo
	RunService.Heartbeat:Connect(function()
		if not arrow.Visible then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end
		local best, bd = nil, math.huge
		for _, d in drops do
			if typeof(d.pos) == "Vector3" then
				local dist = (d.pos - root.Position).Magnitude
				if dist < bd then
					bd, best = dist, d
				end
			end
		end
		if best then
			local cam = Workspace.CurrentCamera
			local rel = cam.CFrame:PointToObjectSpace(best.pos)
			local ang = math.deg(math.atan2(rel.X, -rel.Z))
			arrow.Text = string.format("%s  %dm  %s", if ang < -20 then "◄" else (if ang > 20 then "►" else "▲"), math.floor(bd), best.name)
		end
	end)
end

return Drops
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Effects.lua — sons/visual de level-up e evolução de estágio (anel de luz no Gigante + banner).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)

local Effects = {}
local player = Players.LocalPlayer
local banner: TextLabel
Effects.playSound = nil :: ((string, number?) -> ())?

local function giantOf(userId: number): Model?
	for _, m in Workspace:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("OwnerUserId") == userId then
			return m
		end
	end
	return nil
end

local function ring(model: Model, color: Color3)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	local base = Vector3.new(root.Position.X, 1, root.Position.Z)
	r.Size = Vector3.new(0.5, 4, 4)
	r.CFrame = CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = Workspace
	local s = model:GetScale()
	TweenService:Create(r, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Size = Vector3.new(0.5, 30 * s, 30 * s), Transparency = 1 }):Play()
	task.delay(1.3, function()
		r:Destroy()
	end)
end

function Effects.init(gui: ScreenGui)
	banner = UI.label(gui, "", { Size = UDim2.fromOffset(700, 60), Position = UDim2.new(0.5, 0, 0.18, 0), AnchorPoint = Vector2.new(0.5, 0.5), TextColor3 = UI.Colors.Accent, Visible = false })
	Remotes.GiantEvolved.OnClientEvent:Connect(function(e)
		if type(e) ~= "table" then
			return
		end
		local m = giantOf(e.userId)
		if m then
			ring(m, Color3.fromRGB(255, 220, 80))
			ring(m, Color3.fromRGB(255, 255, 255))
		end
		if e.userId == player.UserId then
			banner.Text = "✨ SEU GIGANTE EVOLUIU: " .. string.upper(e.stageName) .. "! ✨"
			banner.Visible = true
			UI.pop(banner)
			if Effects.playSound then
				Effects.playSound("Evolve", 1)
			end
			task.delay(4, function()
				banner.Visible = false
			end)
		end
	end)
	Remotes.GiantFed.OnClientEvent:Connect(function(e)
		if type(e) == "table" and e.leveled and e.userId == player.UserId and Effects.playSound then
			Effects.playSound("LevelUp", 0.7)
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- HUD.lua — barra superior (moedas, CPS, nível/XP, fome, escudo) e botões de ação (Loja, Inventário, Rebirth, Daily, Códigos).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)

local HUD = {}

local player = Players.LocalPlayer
local coinsLabel: TextLabel
local cpsLabel: TextLabel
local levelLabel: TextLabel
local xpFill: Frame
local xpText: TextLabel
local hungerFill: Frame
local hungerText: TextLabel
local shieldLabel: TextLabel
local rebirthBtn: TextButton
local dailyBtn: TextButton
local lastCoins = 0

HUD.OnOpenShop = nil :: (() -> ())?
HUD.OnOpenInventory = nil :: (() -> ())?
HUD.OnOpenCodes = nil :: (() -> ())?
HUD.OnOpenArena = nil :: (() -> ())?

local function moodColor(h: number): Color3
	if h < 25 then
		return UI.Colors.Red
	elseif h < 70 then
		return UI.Colors.Accent
	end
	return UI.Colors.Green
end

local function moodName(h: number): string
	if h < 25 then
		return "Faminto (0.8x)"
	elseif h < 70 then
		return "Satisfeito (1.0x)"
	end
	return "Feliz (1.25x)"
end

local function buildTopBar(gui: ScreenGui)
	local bar = UI.frame(gui, {
		Name = "TopBar",
		Size = UDim2.new(0, 560, 0, 70),
		Position = UDim2.fromOffset(12, 12),
		BackgroundColor3 = UI.Colors.Bg,
		BackgroundTransparency = 0.1,
	})
	UI.stroke(bar, Color3.new(0, 0, 0), 3)

	-- Moedas
	local coinBox = UI.frame(bar, { Size = UDim2.fromOffset(190, 54), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = UI.Colors.Panel })
	local coinIcon = UI.frame(coinBox, { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(8, 10), BackgroundColor3 = UI.Colors.Accent })
	UI.corner(coinIcon, 17)
	UI.label(coinIcon, "$", { Size = UDim2.fromScale(1, 1), TextColor3 = UI.Colors.Bg })
	coinsLabel = UI.label(coinBox, "0", { Size = UDim2.fromOffset(135, 28), Position = UDim2.fromOffset(50, 4), TextXAlignment = Enum.TextXAlignment.Left })
	cpsLabel = UI.label(coinBox, "+0/s", { Size = UDim2.fromOffset(135, 18), Position = UDim2.fromOffset(50, 32), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Green })

	-- Nível + XP
	local lvlBox = UI.frame(bar, { Size = UDim2.fromOffset(200, 54), Position = UDim2.fromOffset(206, 8), BackgroundColor3 = UI.Colors.Panel })
	levelLabel = UI.label(lvlBox, "Gigante Nv. 1", { Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 2), TextXAlignment = Enum.TextXAlignment.Left })
	local xpBg = UI.frame(lvlBox, { Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 30), BackgroundColor3 = UI.Colors.Bg })
	UI.corner(xpBg, 9)
	xpFill = UI.frame(xpBg, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UI.Colors.Blue })
	UI.corner(xpFill, 9)
	xpText = UI.label(xpBg, "0 / 50 XP", { Size = UDim2.fromScale(1, 1), TextSize = 12, TextScaled = false })

	-- Fome / humor
	local hBox = UI.frame(bar, { Size = UDim2.fromOffset(138, 54), Position = UDim2.fromOffset(414, 8), BackgroundColor3 = UI.Colors.Panel })
	hungerText = UI.label(hBox, "Fome", { Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 2), TextXAlignment = Enum.TextXAlignment.Left })
	local hBg = UI.frame(hBox, { Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 30), BackgroundColor3 = UI.Colors.Bg })
	UI.corner(hBg, 9)
	hungerFill = UI.frame(hBg, { Size = UDim2.fromScale(0.6, 1), BackgroundColor3 = UI.Colors.Green })
	UI.corner(hungerFill, 9)

	-- Escudo (abaixo da barra)
	shieldLabel = UI.label(gui, "", {
		Size = UDim2.fromOffset(300, 24),
		Position = UDim2.fromOffset(16, 86),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UI.Colors.Blue,
		Visible = false,
	})
end

local function buildSideButtons(gui: ScreenGui)
	local col = UI.frame(gui, {
		Name = "SideButtons",
		Size = UDim2.fromOffset(150, 392),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
	})
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = col

	local function side(text: string, color: Color3, order: number, cb: () -> ()): TextButton
		local b = UI.button(col, text, color, { Size = UDim2.new(1, 0, 0, 54), LayoutOrder = order })
		b.MouseButton1Click:Connect(cb)
		return b
	end

	side("LOJA", UI.Colors.Accent, 1, function()
		if HUD.OnOpenShop then
			HUD.OnOpenShop()
		end
	end)
	side("INVENTÁRIO", UI.Colors.Blue, 2, function()
		if HUD.OnOpenInventory then
			HUD.OnOpenInventory()
		end
	end)
	rebirthBtn = side("REBIRTH", Color3.fromRGB(200, 90, 255), 3, function()
		Remotes.RequestRebirth:FireServer()
	end)
	dailyBtn = side("DIÁRIO", UI.Colors.Green, 4, function()
		Remotes.RequestClaimDaily:FireServer()
	end)
	side("ARENA ⚔", UI.Colors.Red, 5, function()
		if HUD.OnOpenArena then
			HUD.OnOpenArena()
		end
	end)
	side("CÓDIGOS", Color3.fromRGB(120, 120, 150), 6, function()
		if HUD.OnOpenCodes then
			HUD.OnOpenCodes()
		end
	end)
end

local function buildFeedButton(gui: ScreenGui)
	local feed = UI.button(gui, "ALIMENTAR GIGANTE", UI.Colors.Green, {
		Name = "FeedButton",
		Size = UDim2.fromOffset(300, 64),
		Position = UDim2.new(0.5, 0, 1, -24),
		AnchorPoint = Vector2.new(0.5, 1),
	})
	UI.stroke(feed, Color3.new(0, 0, 0), 3)
	local hint = UI.label(gui, "Alimenta a comida mais rara do seu pátio (+XP). Comida no pátio gera moedas; comida alimentada vira crescimento.", {
		Size = UDim2.fromOffset(520, 20),
		Position = UDim2.new(0.5, 0, 1, -94),
		AnchorPoint = Vector2.new(0.5, 1),
		TextSize = 13,
		TextScaled = false,
		TextTransparency = 0.25,
	})
	hint.Visible = true

	feed.MouseButton1Click:Connect(function()
		local best: number? = nil
		local bestOrder = 0
		for key, food in State.current.plot do
			local def = Config.FoodById[food.id]
			if def and Config.Rarities[def.rarity].order > bestOrder then
				bestOrder = Config.Rarities[def.rarity].order
				best = tonumber(key)
			end
		end
		if best then
			Remotes.RequestFeed:FireServer(best)
		elseif #State.current.inventory > 0 then
			Remotes.RequestFeed:FireServer({ inv = 1 })
		else
			Remotes.RequestFeed:FireServer(0)
		end
	end)

	local pulse = TweenService:Create(feed, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Size = UDim2.fromOffset(310, 68),
	})
	State.onChanged(function(s)
		local hasFood = next(s.plot) ~= nil or #s.inventory > 0
		feed.BackgroundColor3 = hasFood and UI.Colors.Green or Color3.fromRGB(90, 90, 100)
		if hasFood and s.hunger < 70 then
			pulse:Play()
		else
			pulse:Cancel()
			feed.Size = UDim2.fromOffset(300, 64)
		end
	end)
end

local function refresh(s: State.PlayerState)
	if s.coins ~= lastCoins then
		local delta = s.coins - lastCoins
		lastCoins = s.coins
		coinsLabel.Text = Util.formatNumber(s.coins)
		if delta > 0 then
			TweenService:Create(coinsLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { TextColor3 = UI.Colors.Green }):Play()
		end
	end
	cpsLabel.Text = "+" .. Util.formatNumber(s.cps) .. "/s"
	levelLabel.Text = string.format("%s Nv. %d (x%.1f)", (s :: any).stage or "Gigante", s.level, 1 + s.level * Config.Giant.ScalePerLevel)
	local pct = s.xpNeeded > 0 and math.clamp(s.xp / s.xpNeeded, 0, 1) or 0
	TweenService:Create(xpFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(pct, 1) }):Play()
	xpText.Text = Util.formatNumber(s.xp) .. " / " .. Util.formatNumber(s.xpNeeded) .. " XP"
	hungerText.Text = moodName(s.hunger)
	TweenService:Create(hungerFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(math.clamp(s.hunger / 100, 0, 1), 1), BackgroundColor3 = moodColor(s.hunger) }):Play()

	local canRebirth = s.level >= Config.Rebirth.MinLevel
	rebirthBtn.Text = canRebirth and "REBIRTH!" or ("REBIRTH (Nv." .. Config.Rebirth.MinLevel .. ")")
	rebirthBtn.BackgroundColor3 = canRebirth and Color3.fromRGB(255, 120, 255) or Color3.fromRGB(110, 70, 140)
	if s.rebirths > 0 then
		levelLabel.Text ..= "  R" .. s.rebirths
	end

	local today = os.date("!*t", os.time()).yday
	local lastDay = s.lastDaily > 0 and os.date("!*t", s.lastDaily).yday or -1
	local claimable = today ~= lastDay
	dailyBtn.Text = claimable and "DIÁRIO!" or ("DIÁRIO (" .. s.dailyStreak .. "/7)")
	dailyBtn.BackgroundColor3 = claimable and UI.Colors.Green or Color3.fromRGB(70, 130, 90)
end

local function shieldLoop()
	while true do
		local left = State.current.shieldUntil - os.time()
		if left > 0 then
			shieldLabel.Visible = true
			shieldLabel.Text = string.format("ESCUDO ATIVO: %d:%02d", left // 60, left % 60)
		else
			shieldLabel.Visible = false
		end
		task.wait(1)
	end
end

-- Abre a Loja ao pisar no ShopPad central
local function watchShopPad()
	local map = Workspace:WaitForChild("Map", 30)
	if not map then
		return
	end
	local pad = map:WaitForChild("ShopPad", 30) :: BasePart?
	if not pad then
		return
	end
	local debounce = 0
	pad.Touched:Connect(function(hit)
		local char = player.Character
		if char and hit:IsDescendantOf(char) and os.clock() - debounce > 1.5 then
			debounce = os.clock()
			if HUD.OnOpenShop then
				HUD.OnOpenShop()
			end
		end
	end)
end

function HUD.init(gui: ScreenGui)
	buildTopBar(gui)
	buildSideButtons(gui)
	buildFeedButton(gui)
	State.onChanged(refresh)
	task.spawn(shieldLoop)
	task.spawn(watchShopPad)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Hatch</string>
              <string name="Source"><![CDATA[--!strict
-- Hatch.lua — animação de abertura de Lunchbox: caixa balança, explode em partículas e revela a comida com cor da raridade.
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)

local Hatch = {}

local overlay: Frame
local box: Frame
local reveal: Frame
local revealName: TextLabel
local revealRarity: TextLabel
local busy = false
local queue: { any } = {}

local SOUND_IDS = {
	shake = "rbxassetid://9114653986",
	pop = "rbxassetid://9114611543",
	rare = "rbxassetid://9114646405",
}

local function playSound(id: string, volume: number?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
end

local function burst(parent: Frame, color: Color3, count: number)
	for _ = 1, count do
		local p = Instance.new("Frame")
		p.Size = UDim2.fromOffset(math.random(8, 18), math.random(8, 18))
		p.Position = UDim2.fromScale(0.5, 0.5)
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.BackgroundColor3 = color
		p.BorderSizePixel = 0
		p.Rotation = math.random(0, 360)
		p.Parent = parent
		UI.corner(p, 4)
		local angle = math.random() * math.pi * 2
		local dist = math.random(160, 320)
		TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, math.cos(angle) * dist, 0.5, math.sin(angle) * dist),
			BackgroundTransparency = 1,
			Rotation = p.Rotation + math.random(-180, 180),
		}):Play()
		task.delay(1, function()
			p:Destroy()
		end)
	end
end

local function play(data: { foodId: string, rarity: string, name: string?, color: Color3? })
	busy = true
	local def = Config.FoodById[data.foodId]
	local rar = Config.Rarities[data.rarity] or Config.Rarities.Common
	local isBig = rar.order >= 4

	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.2), { BackgroundTransparency = 0.45 }):Play()

	reveal.Visible = false
	box.Visible = true
	box.Rotation = 0
	box.Size = UDim2.fromOffset(0, 0)
	box.BackgroundColor3 = rar.color
	TweenService:Create(box, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(160, 160) }):Play()
	task.wait(0.35)

	local shakes = isBig and 10 or 6
	for i = 1, shakes do
		local amp = 8 + i * (isBig and 3 or 2)
		TweenService:Create(box, TweenInfo.new(0.06), { Rotation = amp }):Play()
		task.wait(0.06)
		TweenService:Create(box, TweenInfo.new(0.06), { Rotation = -amp }):Play()
		task.wait(0.06)
		if i % 2 == 0 then
			playSound(SOUND_IDS.shake, 0.3)
		end
	end
	TweenService:Create(box, TweenInfo.new(0.1), { Rotation = 0, Size = UDim2.fromOffset(200, 200) }):Play()
	task.wait(0.12)

	box.Visible = false
	burst(overlay, rar.color, isBig and 60 or 28)
	playSound(isBig and SOUND_IDS.rare or SOUND_IDS.pop, isBig and 0.9 or 0.6)

	reveal.BackgroundColor3 = (def and def.color) or (data.color or rar.color)
	revealName.Text = (def and def.name) or (data.name or data.foodId)
	revealRarity.Text = string.upper(data.rarity)
	revealRarity.TextColor3 = rar.color
	reveal.Size = UDim2.fromOffset(0, 0)
	reveal.Visible = true
	TweenService:Create(reveal, TweenInfo.new(0.45, Enum.EasingStyle.Elastic), { Size = UDim2.fromOffset(isBig and 300 or 240, isBig and 300 or 240) }):Play()

	task.wait(isBig and 2.2 or 1.4)
	TweenService:Create(overlay, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(reveal, TweenInfo.new(0.25), { Size = UDim2.fromOffset(0, 0) }):Play()
	task.wait(0.28)
	overlay.Visible = false
	busy = false
end

local function pump()
	while #queue > 0 do
		local data = table.remove(queue, 1)
		if data then
			play(data)
		end
	end
end

function Hatch.init(gui: ScreenGui)
	overlay = Instance.new("Frame")
	overlay.Name = "HatchOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.Visible = false
	overlay.ZIndex = 50
	overlay.Parent = gui

	box = UI.frame(overlay, {
		Size = UDim2.fromOffset(160, 160),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 51,
	})
	UI.corner(box, 20)
	UI.stroke(box, Color3.new(0, 0, 0), 4)
	local lid = UI.frame(box, { Size = UDim2.new(1, 16, 0, 36), Position = UDim2.fromOffset(-8, -10), BackgroundColor3 = Color3.fromRGB(40, 40, 60), ZIndex = 52 })
	UI.corner(lid, 10)
	UI.label(box, "?", { Size = UDim2.fromScale(1, 1), ZIndex = 53, TextColor3 = Color3.new(0, 0, 0), TextTransparency = 0.4 })

	reveal = UI.frame(overlay, {
		Size = UDim2.fromOffset(240, 240),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 51,
	})
	UI.corner(reveal, 28)
	UI.stroke(reveal, Color3.new(1, 1, 1), 4)
	revealName = UI.label(reveal, "", { Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -96), ZIndex = 52 })
	revealRarity = UI.label(reveal, "", { Size = UDim2.new(1, -16, 0, 32), Position = UDim2.new(0, 8, 1, -50), ZIndex = 52 })

	Remotes.HatchResult.OnClientEvent:Connect(function(data)
		if type(data) == "table" and type(data.foodId) == "string" then
			table.insert(queue, data)
			if not busy then
				task.spawn(pump)
			end
		end
	end)
end

return Hatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[--!strict
-- Inventory.lua — janela de Inventário (comidas na mochila) e Pátio (slots ocupados), com ações Colocar / Alimentar / Recolher.
local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)

local Inventory = {}

local win: Frame
local invList: ScrollingFrame
local plotList: ScrollingFrame
local invTitle: TextLabel
local plotTitle: TextLabel

local function clear(container: Instance)
	for _, c in container:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function makeList(parent: Frame, pos: UDim2): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(0.5, -6, 1, -36)
	scroll.Position = pos
	scroll.BackgroundColor3 = UI.Colors.Panel
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = parent
	UI.corner(scroll)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = scroll
	return scroll
end

local function foodRow(parent: Instance, def: Config.FoodDef, order: number, actions: { { text: string, color: Color3, cb: () -> () } }): Frame
	local rar = Config.Rarities[def.rarity]
	local row = UI.frame(parent, { Size = UDim2.new(1, 0, 0, 58), LayoutOrder = order, BackgroundColor3 = UI.Colors.Bg })
	UI.stroke(row, rar.color, 2)
	local swatch = UI.frame(row, { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(8, 9), BackgroundColor3 = def.color })
	UI.corner(swatch, def.shape == "Ball" and 20 or 8)
	UI.label(row, def.name, { Size = UDim2.new(1, -60 - #actions * 92, 0, 26), Position = UDim2.fromOffset(56, 4), TextXAlignment = Enum.TextXAlignment.Left })
	UI.label(row, string.format("%s  ·  %d XP  ·  +%d $/s", def.rarity, rar.xp, rar.cps), {
		Size = UDim2.new(1, -60 - #actions * 92, 0, 20),
		Position = UDim2.fromOffset(56, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextSize = 13,
		TextColor3 = rar.color,
	})
	for i, a in actions do
		local b = UI.button(row, a.text, a.color, { Size = UDim2.fromOffset(84, 40), Position = UDim2.new(1, -(92 * i), 0.5, -20) })
		b.MouseButton1Click:Connect(a.cb)
	end
	return row
end

local function refresh(s: State.PlayerState)
	if not win.Visible then
		return
	end
	clear(invList)
	clear(plotList)

	invTitle.Text = string.format("MOCHILA (%d)", #s.inventory)
	plotTitle.Text = string.format("PÁTIO (%d / %d)", State.plotCount(), s.maxSlots)

	for i, food in s.inventory do
		local def = Config.FoodById[food.id]
		if def then
			local idx = i
			foodRow(invList, def, i, {
				{ text = "COLOCAR", color = UI.Colors.Blue, cb = function()
					Remotes.RequestPlace:FireServer(idx)
				end },
				{ text = "COMER", color = UI.Colors.Green, cb = function()
					Remotes.RequestFeed:FireServer({ inv = idx })
				end },
			})
		end
	end
	if #s.inventory == 0 then
		UI.label(invList, "Vazio. Compre uma Lunchbox na Loja!", { Size = UDim2.new(1, 0, 0, 40), TextTransparency = 0.3 })
	end

	local keys = {}
	for key in s.plot do
		table.insert(keys, tonumber(key) or 0)
	end
	table.sort(keys)
	for order, slot in keys do
		local food = s.plot[tostring(slot)]
		local def = food and Config.FoodById[food.id]
		if def then
			local slotIdx = slot
			foodRow(plotList, def, order, {
				{ text = "RECOLHER", color = Color3.fromRGB(120, 120, 150), cb = function()
					Remotes.RequestPickup:FireServer(slotIdx)
				end },
				{ text = "COMER", color = UI.Colors.Green, cb = function()
					Remotes.RequestFeed:FireServer(slotIdx)
				end },
			})
		end
	end
	if #keys == 0 then
		UI.label(plotList, "Nenhuma comida no pátio. Coloque para gerar moedas.", { Size = UDim2.new(1, 0, 0, 40), TextTransparency = 0.3 })
	end
end

function Inventory.open()
	if not win.Visible then
		UI.pop(win)
		refresh(State.current)
	end
end

function Inventory.init(gui: ScreenGui)
	local body: Frame
	win, body = UI.window(gui, "INVENTÁRIO & PÁTIO", UDim2.fromOffset(760, 500))
	invTitle = UI.label(body, "MOCHILA", { Size = UDim2.new(0.5, -6, 0, 28), TextColor3 = UI.Colors.Blue })
	plotTitle = UI.label(body, "PÁTIO", { Size = UDim2.new(0.5, -6, 0, 28), Position = UDim2.new(0.5, 6, 0, 0), TextColor3 = UI.Colors.Accent })
	invList = makeList(body, UDim2.fromOffset(0, 32))
	plotList = makeList(body, UDim2.new(0.5, 6, 0, 32))
	State.onChanged(refresh)
	win:GetPropertyChangedSignal("Visible"):Connect(function()
		if win.Visible then
			refresh(State.current)
		end
	end)
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!strict
-- Notifications.lua — toasts empilhados, banner de evento global com contagem e alerta de roubo.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)

local Notifications = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local stack: Frame
local banner: Frame
local bannerLabel: TextLabel
local bannerTimer: TextLabel
local activeEventEnd = 0

local MAX_TOASTS = 5

local function pushToast(text: string, color: Color3?, duration: number?)
	local toast = UI.frame(stack, {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = -os.clock(),
	})
	UI.stroke(toast, color or UI.Colors.Accent, 2)
	UI.label(toast, text, {
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or UI.Colors.Text,
	})
	toast.Position = UDim2.fromOffset(300, 0)
	TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Position = UDim2.fromOffset(0, 0) }):Play()

	while #stack:GetChildren() > MAX_TOASTS + 1 do
		local oldest: GuiObject? = nil
		for _, c in stack:GetChildren() do
			if c:IsA("Frame") and (oldest == nil or c.LayoutOrder > oldest.LayoutOrder) then
				oldest = c
			end
		end
		if oldest then
			oldest:Destroy()
		else
			break
		end
	end

	task.delay(duration or 4, function()
		if toast.Parent then
			local t = TweenService:Create(toast, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
			t:Play()
			t.Completed:Wait()
			toast:Destroy()
		end
	end)
end

function Notifications.toast(text: string, color: Color3?, duration: number?)
	pushToast(text, color, duration)
end

local function showBanner(name: string, duration: number, color: Color3)
	activeEventEnd = os.clock() + duration
	banner.BackgroundColor3 = color
	bannerLabel.Text = "EVENTO: " .. string.upper(name)
	banner.Visible = true
	UI.pop(banner)
	task.spawn(function()
		while banner.Visible and os.clock() < activeEventEnd do
			local left = math.max(0, math.ceil(activeEventEnd - os.clock()))
			bannerTimer.Text = string.format("%d:%02d", left // 60, left % 60)
			task.wait(0.25)
		end
	end)
end

local function hideBanner()
	activeEventEnd = 0
	banner.Visible = false
end

local function stealAlert(thiefName: string, food: string)
	pushToast("ALERTA: " .. thiefName .. " está roubando seu " .. food .. "!", UI.Colors.Red, 6)
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = UI.Colors.Red
	flash.BackgroundTransparency = 0.7
	flash.BorderSizePixel = 0
	flash.ZIndex = 0
	flash.Parent = gui
	TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
	task.delay(0.9, function()
		flash:Destroy()
	end)
end

function Notifications.init(parentGui: ScreenGui)
	gui = parentGui

	stack = UI.frame(gui, {
		Name = "Toasts",
		Size = UDim2.fromOffset(320, 300),
		Position = UDim2.new(1, -16, 0, 90),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
	})
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = stack

	banner = UI.frame(gui, {
		Name = "EventBanner",
		Size = UDim2.fromOffset(420, 52),
		Position = UDim2.new(0.5, 0, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
	})
	UI.stroke(banner, Color3.new(0, 0, 0), 3)
	bannerLabel = UI.label(banner, "", {
		Size = UDim2.new(1, -110, 1, -8),
		Position = UDim2.fromOffset(12, 4),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	bannerTimer = UI.label(banner, "0:00", {
		Size = UDim2.fromOffset(90, 40),
		Position = UDim2.new(1, -100, 0, 6),
	})

	Remotes.Notify.OnClientEvent:Connect(function(data)
		if type(data) == "table" and type(data.text) == "string" then
			pushToast(data.text, data.color)
		end
	end)
	Remotes.EventStarted.OnClientEvent:Connect(function(data)
		if type(data) == "table" then
			showBanner(tostring(data.name), tonumber(data.duration) or 60, data.color or UI.Colors.Accent)
		end
	end)
	Remotes.EventEnded.OnClientEvent:Connect(hideBanner)
	Remotes.StealAlert.OnClientEvent:Connect(function(data)
		if type(data) == "table" then
			stealAlert(tostring(data.thiefName), tostring(data.food or "comida"))
		end
	end)

	print("[Client] Notifications pronto para", player.Name)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Shop.lua — janela da Loja: Lunchboxes (moedas), Game Passes e Dev Products (Robux), além de janela de Códigos.
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)

local Shop = {}

local player = Players.LocalPlayer
local win: Frame
local codesWin: Frame
local boxButtons: { [string]: TextButton } = {}
local passButtons: { [string]: TextButton } = {}

local PASS_INFO = {
	{ key = "DoubleCoins", name = "2x Moedas", desc = "Dobra toda a renda do pátio." },
	{ key = "VIP", name = "VIP", desc = "+4 slots no pátio, 1.5x XP e nametag." },
	{ key = "AutoFeed", name = "Auto-Feed", desc = "Alimenta seu Gigante sozinho a cada 5s." },
	{ key = "Guardian", name = "Guardião", desc = "Seu Gigante NUNCA encolhe por ausência + aura dourada." },
	{ key = "BoxerPro", name = "Boxer Pro", desc = "+25% dano, +30% stamina nos socos." },
	{ key = "ArenaVIP", name = "Arena VIP", desc = "Cooldown de duelo pela metade e rouba 3 comidas ao vencer." },
	{ key = "DragonGiant", name = "Gigante Dragão", desc = "Espécie SECRETA: 2x XP, +50% moedas, nunca encolhe." },
	{ key = "PhoenixGiant", name = "Gigante Fênix", desc = "Espécie SECRETA: Rebirth dá +50%, nunca encolhe." },
}

local PRODUCT_INFO = {
	{ key = "Coins10k", name = "10.000 Moedas", desc = "Impulso rápido para a próxima Lunchbox." },
	{ key = "Coins100k", name = "100.000 Moedas", desc = "Pule direto para as caixas Lendárias." },
	{ key = "SuperShield", name = "Super Escudo", desc = "10 minutos sem roubos na sua base." },
	{ key = "LuckyBox", name = "Lucky Lunchbox", desc = "Rara ou melhor, garantido." },
	{ key = "FreezeDecay7d", name = "Congelar Encolhimento (7d)", desc = "Seu Gigante não perde níveis por 7 dias." },
	{ key = "RestoreLevels", name = "Restaurar Níveis", desc = "Recupera TODOS os níveis perdidos por ausência." },
	{ key = "StaminaRefill", name = "Stamina Infinita (60s)", desc = "Stamina cheia + 60s sem gastar stamina." },
	{ key = "ArenaRematch", name = "Revanche", desc = "Zera o cooldown de duelo agora." },
	{ key = "SpeciesReroll", name = "Espécie Surpresa", desc = "Desbloqueia uma espécie aleatória que você não tem." },
}

local function oddsText(box: Config.LunchboxDef): string
	local parts = {}
	local ordered = {}
	for rarity, w in box.weights do
		table.insert(ordered, { r = rarity, w = w, o = Config.Rarities[rarity].order })
	end
	table.sort(ordered, function(a, b)
		return a.o < b.o
	end)
	for _, e in ordered do
		table.insert(parts, string.format("%s %s%%", e.r, tostring(e.w)))
	end
	return table.concat(parts, "  ·  ")
end

local function buildBoxesTab(parent: Frame)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.fromOffset(0, #Config.Lunchboxes * 118)
	scroll.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	for i, box in Config.Lunchboxes do
		local card = UI.frame(scroll, { Size = UDim2.new(1, -10, 0, 110), LayoutOrder = i })
		UI.stroke(card, box.color, 3)
		local icon = UI.frame(card, { Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(12, 15), BackgroundColor3 = box.color })
		UI.label(icon, "?", { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.new(0, 0, 0), TextTransparency = 0.3 })
		UI.label(card, box.name, { Size = UDim2.new(1, -260, 0, 32), Position = UDim2.fromOffset(104, 10), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = box.color })
		UI.label(card, oddsText(box), {
			Size = UDim2.new(1, -260, 0, 50),
			Position = UDim2.fromOffset(104, 46),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextScaled = false,
			TextSize = 13,
			TextWrapped = true,
			TextTransparency = 0.2,
		})
		local btn = UI.button(card, Util.formatNumber(box.price) .. " $", UI.Colors.Green, {
			Size = UDim2.fromOffset(140, 52),
			Position = UDim2.new(1, -152, 0.5, -26),
		})
		btn.MouseButton1Click:Connect(function()
			Remotes.RequestBuyBox:FireServer(box.id)
		end)
		boxButtons[box.id] = btn
	end
end

local function buildRobuxTab(parent: Frame)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.fromOffset(0, (#PASS_INFO + #PRODUCT_INFO) * 84 + 60)
	scroll.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	local order = 0
	local function row(name: string, desc: string, color: Color3, buttonText: string, cb: () -> ()): TextButton
		order += 1
		local card = UI.frame(scroll, { Size = UDim2.new(1, -10, 0, 76), LayoutOrder = order })
		UI.stroke(card, color, 2)
		UI.label(card, name, { Size = UDim2.new(1, -200, 0, 30), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color })
		UI.label(card, desc, { Size = UDim2.new(1, -200, 0, 32), Position = UDim2.fromOffset(12, 38), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = false, TextSize = 14, TextWrapped = true, TextTransparency = 0.2 })
		local btn = UI.button(card, buttonText, color, { Size = UDim2.fromOffset(160, 48), Position = UDim2.new(1, -172, 0.5, -24) })
		btn.MouseButton1Click:Connect(cb)
		return btn
	end

	order += 1
	UI.label(scroll, "GAME PASSES", { Size = UDim2.new(1, -10, 0, 24), LayoutOrder = order, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Accent })
	for _, p in PASS_INFO do
		passButtons[p.key] = row(p.name, p.desc, UI.Colors.Accent, "COMPRAR", function()
			Remotes.RequestGamePass:FireServer(p.key)
		end)
	end
	order += 1
	UI.label(scroll, "PRODUTOS", { Size = UDim2.new(1, -10, 0, 24), LayoutOrder = order, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Blue })
	for _, p in PRODUCT_INFO do
		row(p.name, p.desc, UI.Colors.Blue, "ROBUX", function()
			Remotes.RequestPurchase:FireServer(p.key)
		end)
	end
end

local speciesCards: { [string]: TextButton } = {}
local function buildSpeciesTab(parent: Frame)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.fromOffset(0, #Config.Species * 92 + 40)
	scroll.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	UI.label(scroll, "Cada espécie muda forma, XP, moedas, fome e força na arena. Trocar é grátis depois de comprar.", { Size = UDim2.new(1, -10, 0, 30), LayoutOrder = 0, TextScaled = false, TextSize = 13, TextWrapped = true, TextTransparency = 0.2 })
	for i, sp in Config.Species do
		local card = UI.frame(scroll, { Size = UDim2.new(1, -10, 0, 84), LayoutOrder = i })
		UI.stroke(card, sp.color, 2)
		local icon = UI.frame(card, { Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 14), BackgroundColor3 = sp.skin })
		UI.corner(icon, 28)
		UI.stroke(icon, sp.color, 3)
		UI.label(card, sp.name .. "  [" .. sp.rarityTag .. "]", { Size = UDim2.new(1, -260, 0, 26), Position = UDim2.fromOffset(76, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = sp.color })
		UI.label(card, sp.desc, { Size = UDim2.new(1, -260, 0, 30), Position = UDim2.fromOffset(76, 32), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = false, TextSize = 13, TextWrapped = true, TextTransparency = 0.2 })
		UI.label(card, string.format("XP x%.2f • $ x%.2f • Arena %d/%dHP", sp.xpMult, sp.coinMult, sp.arenaPower, sp.arenaHp), { Size = UDim2.new(1, -260, 0, 16), Position = UDim2.fromOffset(76, 62), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = false, TextSize = 11, TextColor3 = UI.Colors.Accent })
		local btn = UI.button(card, "", sp.color, { Size = UDim2.fromOffset(160, 48), Position = UDim2.new(1, -172, 0.5, -24) })
		btn.MouseButton1Click:Connect(function()
			local s = State.current :: any
			local owned = s.ownedSpecies and s.ownedSpecies[sp.id]
			if owned then
				Remotes.RequestEquipSpecies:FireServer(sp.id)
			elseif sp.robux and sp.passKey then
				Remotes.RequestGamePass:FireServer(sp.passKey)
			else
				Remotes.RequestBuySpecies:FireServer(sp.id)
			end
		end)
		speciesCards[sp.id] = btn
	end
end

local function refreshSpecies(s: State.PlayerState)
	local a = s :: any
	for _, sp in Config.Species do
		local btn = speciesCards[sp.id]
		if not btn then
			continue
		end
		local owned = a.ownedSpecies and a.ownedSpecies[sp.id]
		if a.species == sp.id then
			btn.Text = "EQUIPADO ✓"
			btn.BackgroundColor3 = UI.Colors.Green
		elseif owned then
			btn.Text = "EQUIPAR"
			btn.BackgroundColor3 = UI.Colors.Blue
		elseif sp.robux then
			btn.Text = "ROBUX"
			btn.BackgroundColor3 = Color3.fromRGB(90, 200, 90)
		else
			btn.Text = "$ " .. Util.formatNumber(sp.price)
			btn.BackgroundColor3 = if s.coins >= sp.price then sp.color else Color3.fromRGB(90, 90, 110)
		end
	end
end

local function buildCodes(gui: ScreenGui)
	local body: Frame
	codesWin, body = UI.window(gui, "CÓDIGOS", UDim2.fromOffset(380, 220))
	UI.label(body, "Digite um código promocional:", { Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left })
	local input = Instance.new("TextBox")
	input.Size = UDim2.new(1, 0, 0, 48)
	input.Position = UDim2.fromOffset(0, 36)
	input.BackgroundColor3 = UI.Colors.Panel
	input.BorderSizePixel = 0
	input.Font = UI.Font
	input.TextColor3 = UI.Colors.Text
	input.TextScaled = true
	input.PlaceholderText = "EX: GIGANTE"
	input.Text = ""
	input.ClearTextOnFocus = false
	input.Parent = body
	UI.corner(input)
	UI.stroke(input, UI.Colors.Accent, 2)
	local redeem = UI.button(body, "RESGATAR", UI.Colors.Green, { Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 96) })
	redeem.MouseButton1Click:Connect(function()
		local code = string.upper((string.gsub(input.Text, "%s", "")))
		if #code > 0 then
			Remotes.RequestRedeemCode:FireServer(code)
			input.Text = ""
		end
	end)
end

local function refresh(s: State.PlayerState)
	for id, btn in boxButtons do
		local box = Config.LunchboxById[id]
		local can = s.coins >= box.price
		btn.BackgroundColor3 = can and UI.Colors.Green or Color3.fromRGB(90, 90, 100)
		btn.Text = Util.formatNumber(box.price) .. " $"
	end
	for key, btn in passButtons do
		if s.passes[key] then
			btn.Text = "ATIVO"
			btn.BackgroundColor3 = Color3.fromRGB(70, 130, 90)
		end
	end
end

function Shop.open()
	if not win.Visible then
		UI.pop(win)
	end
end

function Shop.openCodes()
	if not codesWin.Visible then
		UI.pop(codesWin)
	end
end

function Shop.init(gui: ScreenGui)
	local body: Frame
	win, body = UI.window(gui, "LUNCHBOX SHOP", UDim2.fromOffset(640, 540))

	local tabs = UI.frame(body, { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 })
	local pages = UI.frame(body, { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1 })
	local boxesPage = UI.frame(pages, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local speciesPage = UI.frame(pages, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })
	local robuxPage = UI.frame(pages, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })
	buildBoxesTab(boxesPage)
	buildSpeciesTab(speciesPage)
	buildRobuxTab(robuxPage)

	local inactive = Color3.fromRGB(90, 90, 110)
	local tabBoxes = UI.button(tabs, "LUNCHBOXES", UI.Colors.Accent, { Size = UDim2.new(1 / 3, -4, 1, 0) })
	local tabSpecies = UI.button(tabs, "ESPÉCIES", inactive, { Size = UDim2.new(1 / 3, -4, 1, 0), Position = UDim2.new(1 / 3, 2, 0, 0) })
	local tabRobux = UI.button(tabs, "ROBUX", inactive, { Size = UDim2.new(1 / 3, -4, 1, 0), Position = UDim2.new(2 / 3, 4, 0, 0) })
	local function show(page: Frame, btn: TextButton, color: Color3)
		boxesPage.Visible = page == boxesPage
		speciesPage.Visible = page == speciesPage
		robuxPage.Visible = page == robuxPage
		tabBoxes.BackgroundColor3 = inactive
		tabSpecies.BackgroundColor3 = inactive
		tabRobux.BackgroundColor3 = inactive
		btn.BackgroundColor3 = color
	end
	tabBoxes.MouseButton1Click:Connect(function()
		show(boxesPage, tabBoxes, UI.Colors.Accent)
	end)
	tabSpecies.MouseButton1Click:Connect(function()
		show(speciesPage, tabSpecies, UI.Colors.Green)
	end)
	tabRobux.MouseButton1Click:Connect(function()
		show(robuxPage, tabRobux, UI.Colors.Blue)
	end)

	buildCodes(gui)
	State.onChanged(refresh)
	State.onChanged(refreshSpecies)
	print("[Client] Shop pronto para", player.Name)
end

return Shop
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="38">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Main.client.lua — ponto de entrada do cliente. Cria o ScreenGui e inicializa controladores.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local State = require(script.Parent.State)
local Controllers = script.Parent.Controllers
local HUD = require(Controllers.HUD)
local Shop = require(Controllers.Shop)
local Inventory = require(Controllers.Inventory)
local Hatch = require(Controllers.Hatch)
local Notifications = require(Controllers.Notifications)
local Combat = require(Controllers.Combat)
local Drops = require(Controllers.Drops)
local Arena = require(Controllers.Arena)
local Effects = require(Controllers.Effects)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "FeedAGiantGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

State.init()
Notifications.init(gui)
HUD.init(gui)
Shop.init(gui)
Inventory.init(gui)
Hatch.init(gui)
Combat.init(gui)
Drops.init(gui)
Arena.init(gui)
Effects.init(gui)
Arena.playSound = Combat.sound
Arena.shake = Combat.shake
Effects.playSound = Combat.sound

HUD.OnOpenShop = Shop.open
HUD.OnOpenInventory = Inventory.open
HUD.OnOpenCodes = Shop.openCodes
HUD.OnOpenArena = Arena.open

print("[FeedAGiant] Cliente pronto.")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- State.lua — cache local do estado do jogador recebido via StateChanged, com assinatura de mudanças.
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)

export type FoodInstance = { id: string, uid: string }
export type PlayerState = {
	coins: number,
	level: number,
	xp: number,
	xpNeeded: number,
	rebirths: number,
	hunger: number,
	inventory: { FoodInstance },
	plot: { [string]: FoodInstance },
	maxSlots: number,
	cps: number,
	passes: { [string]: boolean },
	shieldUntil: number,
	dailyStreak: number,
	lastDaily: number,
	species: string?,
	ownedSpecies: { [string]: boolean }?,
	stage: string?,
	arenaWins: number?,
	arenaLosses: number?,
	lastDuel: number?,
	levelsLostToDecay: number?,
	championUntil: number?,
}

local State = {}

State.current = {
	coins = 0,
	level = 1,
	xp = 0,
	xpNeeded = 50,
	rebirths = 0,
	hunger = 60,
	inventory = {},
	plot = {},
	maxSlots = 12,
	cps = 0,
	passes = {},
	shieldUntil = 0,
	dailyStreak = 0,
	lastDaily = 0,
} :: PlayerState

State.Changed = Instance.new("BindableEvent")

local function apply(data: { [string]: any })
	local s = State.current :: any
	for k, v in data do
		s[k] = v
	end
	State.Changed:Fire(State.current)
end

function State.onChanged(callback: (PlayerState) -> ()): RBXScriptConnection
	callback(State.current)
	return State.Changed.Event:Connect(callback)
end

function State.plotCount(): number
	local n = 0
	for _ in State.current.plot do
		n += 1
	end
	return n
end

function State.init()
	Remotes.StateChanged.OnClientEvent:Connect(function(data)
		if type(data) == "table" then
			apply(data)
		end
	end)
	task.spawn(function()
		local ok, _ = pcall(function()
			return Remotes.GetFullState:InvokeServer()
		end)
		if not ok then
			warn("[Client] Falha ao solicitar estado inicial")
		end
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- UI.lua — construtores de UI reutilizáveis (estilo cartoon/chunky típico de simuladores de topo).
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.Colors = {
	Bg = Color3.fromRGB(28, 30, 48),
	Panel = Color3.fromRGB(40, 44, 70),
	Accent = Color3.fromRGB(255, 170, 40),
	Green = Color3.fromRGB(70, 220, 120),
	Red = Color3.fromRGB(255, 80, 80),
	Blue = Color3.fromRGB(80, 170, 255),
	Text = Color3.new(1, 1, 1),
}

function UI.corner(inst: GuiObject, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = inst
	return c
end

function UI.stroke(inst: GuiObject, color: Color3?, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

function UI.frame(parent: Instance, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = UI.Colors.Panel
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	f.Parent = parent
	UI.corner(f)
	return f
end

function UI.label(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = UI.Font
	l.TextColor3 = UI.Colors.Text
	l.TextScaled = true
	l.Text = text
	l.TextStrokeTransparency = 0.5
	if props then
		for k, v in props do
			(l :: any)[k] = v
		end
	end
	l.Parent = parent
	return l
end

function UI.button(parent: Instance, text: string, color: Color3, props: { [string]: any }?): TextButton
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.Font = UI.Font
	b.TextColor3 = UI.Colors.Text
	b.TextScaled = true
	b.Text = text
	b.AutoButtonColor = false
	b.TextStrokeTransparency = 0.6
	if props then
		for k, v in props do
			(b :: any)[k] = v
		end
	end
	b.Parent = parent
	UI.corner(b)
	UI.stroke(b, Color3.new(0, 0, 0), 2)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.2) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.08), { Size = b.Size - UDim2.fromOffset(4, 4) }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.08), { Size = b.Size + UDim2.fromOffset(4, 4) }):Play()
	end)
	return b
end

function UI.pop(inst: GuiObject)
	local target = inst.Size
	inst.Size = UDim2.fromScale(0, 0)
	inst.Visible = true
	TweenService:Create(inst, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = target }):Play()
end

function UI.window(parent: Instance, title: string, size: UDim2): (Frame, Frame)
	local win = UI.frame(parent, {
		Name = title,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.Colors.Bg,
		Visible = false,
	})
	UI.stroke(win, Color3.new(0, 0, 0), 3)
	local header = UI.frame(win, {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = UI.Colors.Accent,
	})
	UI.label(header, title, { Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left })
	local close = UI.button(header, "X", UI.Colors.Red, { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -40, 0, 4) })
	close.MouseButton1Click:Connect(function()
		win.Visible = false
	end)
	local body = UI.frame(win, {
		Size = UDim2.new(1, -16, 1, -60),
		Position = UDim2.fromOffset(8, 52),
		BackgroundTransparency = 1,
	})
	return win, body
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
