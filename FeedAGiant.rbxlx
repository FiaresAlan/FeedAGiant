      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Main.server.lua — ponto de entrada do servidor. Inicializa serviços em ordem e gerencia entrada/saída de jogadores.
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)

local Services = script.Parent.Services
local DataService = require(Services.DataService)
local MapService = require(Services.MapService)
local GiantService = require(Services.GiantService)
local PlotService = require(Services.PlotService)
local StealService = require(Services.StealService)
local ShopService = require(Services.ShopService)
local EventService = require(Services.EventService)
local MonetizationService = require(Services.MonetizationService)
local LeaderboardService = require(Services.LeaderboardService)
local CombatService = require(Services.CombatService)
local DropService = require(Services.DropService)
local ArenaService = require(Services.ArenaService)

print("[FeedAGiant] Iniciando servidor...")

MapService.init()
DataService.init()
GiantService.init()
PlotService.init()
StealService.init()
ShopService.init()
MonetizationService.init()
LeaderboardService.init()
EventService.init()
CombatService.init()
DropService.init()
ArenaService.init()

local function onPlayerAdded(player: Player)
	local profile = DataService.waitFor(player, 20)
	if not profile then
		player:Kick("Falha ao carregar seus dados. Tente novamente.")
		return
	end
	local base = MapService.claimBase(player)
	if not base then
		player:Kick("Servidor cheio.")
		return
	end
	GiantService.onPassesChanged(player)
	GiantService.applyDecay(player, profile)
	GiantService.spawnFor(player)
	PlotService.rebuildPlot(player)
	StealService.giveShield(player, Config.Steal.SpawnShieldSec)
	PlotService.pushState(player)

	-- Teleporta o jogador para sua base ao (re)nascer
	player.CharacterAdded:Connect(function(char)
		task.wait(0.2)
		local b = MapService.getBaseOf(player)
		if b then
			char:PivotTo(b.origin * CFrame.new(0, 6, 20))
		end
	end)
	if player.Character then
		player.Character:PivotTo(base.origin * CFrame.new(0, 6, 20))
	end

	-- Kit inicial: 2 comidas comuns para o loop começar imediatamente
	if profile.totalBoxes == 0 and #profile.inventory == 0 and next(profile.plot) == nil then
		PlotService.giveFood(player, "apple")
		PlotService.giveFood(player, "bread")
		Remotes.Notify:FireClient(player, { text = "Bem-vindo! Coloque comida no pátio e alimente seu Gigante.", color = Color3.fromRGB(255, 220, 80) })
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	MapService.releaseBase(player)
end)

print("[FeedAGiant] Servidor pronto. Bases:", #MapService.Bases)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ArenaService</string>
            <string name="Source"><![CDATA[--!strict
-- ArenaService — Giant Clash: duelos 1v1 encenados entre Gigantes + campeonato automático a cada 15 min.
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local GiantService = require(script.Parent.GiantService)
local ShopService = require(script.Parent.ShopService)

local A = Config.Arena
local ArenaService = {}
local pending: { [Player]: { challenger: Player, at: number } } = {} -- target -> desafio
local busy: { [Player]: boolean } = {}

local function notify(p: Player, text: string, color: Color3)
	Remotes.Notify:FireClient(p, { text = text, color = color })
end

function ArenaService.power(player: Player): number
	local profile = DataService.get(player)
	if not profile then
		return 0
	end
	local sp = GiantService.species(profile)
	return sp.arenaPower * (1 + profile.level * A.LevelFactor) * (1 + profile.rebirths * A.RebirthFactor) * GiantService.moodMultiplier(profile)
end

local function canFight(p: Player): (boolean, string?)
	local profile = DataService.get(p)
	if not profile then
		return false, "Dados não carregados."
	end
	if profile.level < A.MinLevelToFight then
		return false, "Gigante precisa ser nível " .. A.MinLevelToFight .. "."
	end
	if busy[p] then
		return false, "Já está em uma luta."
	end
	return true, nil
end

local function cooldownLeft(p: Player): number
	local profile = DataService.get(p)
	if not profile then
		return 0
	end
	local cd = if profile.passes.ArenaVIP then A.DuelCooldown / 2 else A.DuelCooldown
	return math.max(0, profile.lastDuel + cd - os.time())
end

local function stealFromLoser(winner: Player, loser: Player): { string }
	local wp, lp = DataService.get(winner), DataService.get(loser)
	if not wp or not lp then
		return {}
	end
	local n = if wp.passes.ArenaVIP then A.WinStealFoodCount + 1 else A.WinStealFoodCount
	local slots = {}
	for key, food in lp.plot do
		local def = Config.FoodById[food.id]
		if def then
			table.insert(slots, { slot = tonumber(key) :: number, order = Config.Rarities[def.rarity].order, id = food.id })
		end
	end
	table.sort(slots, function(a, b)
		return a.order > b.order
	end)
	local names = {}
	for i = 1, math.min(n, #slots) do
		local item = PlotService.removeFromPlot(loser, slots[i].slot)
		if item then
			PlotService.giveFood(winner, item.id)
			table.insert(names, Config.FoodById[item.id].name)
		end
	end
	local coins = math.min(A.WinCoinsCap, math.floor(lp.coins * A.WinCoinsPct))
	lp.coins -= coins
	wp.coins += coins
	return names
end

-- Luta encenada: servidor decide o vencedor por poder + sorte, manda ticks para os clientes animarem.
local function runDuel(a: Player, b: Player, tournament: boolean): Player?
	busy[a], busy[b] = true, true
	local pa, pb = ArenaService.power(a), ArenaService.power(b)
	local ra = pa * (1 + (math.random() * 2 - 1) * A.LuckRange)
	local rb = pb * (1 + (math.random() * 2 - 1) * A.LuckRange)
	local winner, loser = if ra >= rb then a else b, if ra >= rb then b else a
	local hpA, hpB = 100, 100
	local pay = { kind = "Start", a = a.UserId, b = b.UserId, aName = a.DisplayName, bName = b.DisplayName, powerA = math.floor(pa), powerB = math.floor(pb), seconds = A.RoundSeconds, tournament = tournament }
	Remotes.ArenaState:FireAllClients(pay)
	local ticks = 8
	for i = 1, ticks do
		task.wait(A.RoundSeconds / ticks)
		if not a.Parent or not b.Parent then
			break
		end
		local hitA = (winner == a and 10 + math.random(0, 8) or 4 + math.random(0, 6))
		local hitB = (winner == b and 10 + math.random(0, 8) or 4 + math.random(0, 6))
		hpB = math.max(if i == ticks and winner == a then 0 else 1, hpB - hitA)
		hpA = math.max(if i == ticks and winner == b then 0 else 1, hpA - hitB)
		Remotes.ArenaState:FireAllClients({ kind = "Tick", a = a.UserId, b = b.UserId, hpA = hpA, hpB = hpB, attacker = if i % 2 == 0 then a.UserId else b.UserId })
	end
	if not a.Parent or not b.Parent then
		busy[a], busy[b] = nil, nil
		Remotes.ArenaState:FireAllClients({ kind = "End", a = a.UserId, b = b.UserId, winner = 0, aborted = true })
		return nil
	end
	local wp, lp = DataService.get(winner), DataService.get(loser)
	local stolen = {}
	if wp and lp then
		wp.arenaWins += 1
		wp.arenaStreak += 1
		lp.arenaLosses += 1
		lp.arenaStreak = 0
		lp.duelProtectionUntil = os.time() + A.LoserProtectionSec
		if not tournament then
			stolen = stealFromLoser(winner, loser)
		end
		DataService.markDirty(winner)
		DataService.markDirty(loser)
		PlotService.pushState(winner)
		PlotService.pushState(loser)
	end
	Remotes.ArenaState:FireAllClients({ kind = "End", a = a.UserId, b = b.UserId, winner = winner.UserId, winnerName = winner.DisplayName, stolen = stolen, tournament = tournament })
	Remotes.Notify:FireAllClients({ text = "⚔️ " .. winner.DisplayName .. " venceu " .. loser.DisplayName .. " no Giant Clash!", color = Color3.fromRGB(255, 200, 60) })
	busy[a], busy[b] = nil, nil
	return winner
end

local function requestDuel(challenger: Player, targetId: number)
	local target = Players:GetPlayerByUserId(targetId)
	if not target or target == challenger then
		return
	end
	local ok, why = canFight(challenger)
	if not ok then
		return notify(challenger, why :: string, Color3.fromRGB(255, 120, 80))
	end
	local ok2, why2 = canFight(target)
	if not ok2 then
		return notify(challenger, target.DisplayName .. ": " .. (why2 :: string), Color3.fromRGB(255, 120, 80))
	end
	local cd = cooldownLeft(challenger)
	if cd > 0 then
		return notify(challenger, "Aguarde " .. cd .. "s para desafiar de novo (ou compre Revanche).", Color3.fromRGB(255, 120, 80))
	end
	local tp = DataService.get(target)
	if tp and tp.duelProtectionUntil > os.time() then
		return notify(challenger, target.DisplayName .. " está protegido por " .. (tp.duelProtectionUntil - os.time()) .. "s.", Color3.fromRGB(120, 200, 255))
	end
	if pending[target] then
		return notify(challenger, target.DisplayName .. " já tem um desafio pendente.", Color3.fromRGB(255, 120, 80))
	end
	pending[target] = { challenger = challenger, at = os.time() }
	Remotes.ArenaState:FireClient(target, { kind = "Challenge", from = challenger.UserId, fromName = challenger.DisplayName, power = math.floor(ArenaService.power(challenger)) })
	Remotes.ArenaState:FireClient(challenger, { kind = "Sent", to = target.UserId, toName = target.DisplayName })
	task.delay(20, function()
		local p = pending[target]
		if p and p.challenger == challenger then
			pending[target] = nil
			Remotes.ArenaState:FireClient(challenger, { kind = "Declined", by = target.UserId, timeout = true })
		end
	end)
end

local function answerDuel(target: Player, challengerId: number, accept: boolean)
	local p = pending[target]
	if not p or p.challenger.UserId ~= challengerId then
		return
	end
	pending[target] = nil
	local challenger = p.challenger
	if not accept or not challenger.Parent then
		Remotes.ArenaState:FireClient(challenger, { kind = "Declined", by = target.UserId })
		return
	end
	local ok1 = canFight(challenger)
	local ok2 = canFight(target)
	if not ok1 or not ok2 then
		return
	end
	local cp, tp = DataService.get(challenger), DataService.get(target)
	if cp then
		cp.lastDuel = os.time()
	end
	if tp then
		tp.lastDuel = os.time()
	end
	task.spawn(runDuel, challenger, target, false)
end

local function runTournament()
	local pool = {}
	for _, p in Players:GetPlayers() do
		local ok = canFight(p)
		if ok then
			table.insert(pool, p)
		end
	end
	if #pool < A.TournamentMinPlayers then
		return
	end
	for i = #pool, 2, -1 do
		local j = math.random(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	Remotes.ArenaState:FireAllClients({ kind = "Tournament", players = #pool })
	Remotes.Notify:FireAllClients({ text = "🏆 CAMPEONATO GIANT CLASH começou com " .. #pool .. " gigantes!", color = Color3.fromRGB(255, 220, 80) })
	task.wait(5)
	while #pool > 1 do
		local nextRound = {}
		for i = 1, #pool, 2 do
			local a, b = pool[i], pool[i + 1]
			if not b then
				table.insert(nextRound, a)
			elseif a.Parent and b.Parent then
				local w = runDuel(a, b, true)
				if w then
					table.insert(nextRound, w)
				end
				task.wait(3)
			elseif a.Parent then
				table.insert(nextRound, a)
			elseif b.Parent then
				table.insert(nextRound, b)
			end
		end
		pool = nextRound
	end
	local champ = pool[1]
	if champ and champ.Parent then
		local profile = DataService.get(champ)
		if profile then
			profile.championships += 1
			profile.championUntil = os.time() + A.ChampionTrophyDays * 86400
			profile.coins += A.TournamentPrizeCoins
			DataService.markDirty(champ)
			ShopService.openBox(champ, A.TournamentPrizeBox, true, nil)
			GiantService.refresh(champ, true)
			PlotService.pushState(champ)
		end
		Remotes.Notify:FireAllClients({ text = "👑 " .. champ.DisplayName .. " é o CAMPEÃO do Giant Clash! (+" .. A.TournamentPrizeCoins .. " moedas + Lunchbox Lendária)", color = Color3.fromRGB(255, 255, 255) })
	end
end

function ArenaService.init()
	Remotes.RequestDuel.OnServerEvent:Connect(function(player, targetId)
		if type(targetId) == "number" then
			requestDuel(player, targetId)
		end
	end)
	Remotes.RequestDuelAnswer.OnServerEvent:Connect(function(player, challengerId, accept)
		if type(challengerId) == "number" then
			answerDuel(player, challengerId, accept == true)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
		busy[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(A.TournamentEvery)
			local ok, err = pcall(runTournament)
			if not ok then
				warn("[ArenaService]", err)
			end
		end
	end)
end

return ArenaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
-- CombatService — BOXE. Socos leves/pesados, bloqueio, stamina, combo e KO.
-- Substitui o bastão da v1. Usado para disputar drops, defender o pátio e brigar na arena.
-- Regras anti-grief: ninguém pode ser socado dentro da zona segura do PRÓPRIO pátio.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)

local CombatService = {}

export type Fighter = {
	stamina: number,
	hp: number,
	blocking: boolean,
	lastPunch: number,
	lastHeavy: number,
	combo: number,
	comboAt: number,
	koUntil: number,
	infiniteStaminaUntil: number,
	lastHitBy: Player?,
}

local fighters: { [Player]: Fighter } = {}
local C = Config.Combat

-- callbacks que outros serviços registram (DropService, ArenaService)
CombatService.OnHit = nil :: ((attacker: Player, victim: Player, heavy: boolean) -> ())?
CombatService.OnKO = nil :: ((attacker: Player, victim: Player) -> ())?

local function getFighter(player: Player): Fighter
	local f = fighters[player]
	if not f then
		f = {
			stamina = C.MaxStamina,
			hp = C.KOHealth,
			blocking = false,
			lastPunch = 0,
			lastHeavy = 0,
			combo = 0,
			comboAt = 0,
			koUntil = 0,
			infiniteStaminaUntil = 0,
			lastHitBy = nil,
		}
		fighters[player] = f
	end
	return f
end

function CombatService.get(player: Player): Fighter
	return getFighter(player)
end

function CombatService.maxStamina(player: Player): number
	local profile = DataService.get(player)
	local m = C.MaxStamina
	if profile and profile.passes.BoxerPro then
		m = math.floor(m * 1.3)
	end
	return m
end

function CombatService.isKO(player: Player): boolean
	return getFighter(player).koUntil > os.clock()
end

local function push(player: Player)
	local f = getFighter(player)
	Remotes.CombatState:FireClient(player, {
		stamina = f.stamina,
		maxStamina = CombatService.maxStamina(player),
		hp = f.hp,
		maxHp = C.KOHealth,
		blocking = f.blocking,
		combo = f.combo,
		ko = f.koUntil > os.clock(),
		koUntil = f.koUntil,
	})
end

function CombatService.refillStamina(player: Player, infiniteSeconds: number?)
	local f = getFighter(player)
	f.stamina = CombatService.maxStamina(player)
	if infiniteSeconds then
		f.infiniteStaminaUntil = os.clock() + infiniteSeconds
	end
	push(player)
end

-- Zona segura: perto do próprio pátio ninguém pode te socar.
local function inOwnSafeZone(player: Player): boolean
	local base = MapService.getBaseOf(player)
	local char = player.Character
	if not base or not char then
		return false
	end
	return (char:GetPivot().Position - base.origin.Position).Magnitude < C.SafeZoneRadius
end

local function rootOf(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoidOf(player: Player): Humanoid?
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function hitFx(pos: Vector3, heavy: boolean)
	local p = Util.makePart({
		Name = "HitFX",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(pos),
		Color = if heavy then Color3.fromRGB(255, 80, 40) else Color3.fromRGB(255, 220, 80),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = Workspace,
	})
	task.spawn(function()
		for i = 1, 6 do
			p.Size = p.Size + Vector3.new(1.2, 1.2, 1.2)
			p.Transparency = i / 6
			task.wait(0.03)
		end
		p:Destroy()
	end)
end

local function knockout(victim: Player, attacker: Player)
	local f = getFighter(victim)
	f.koUntil = os.clock() + C.KOSeconds
	f.hp = C.KOHealth
	f.combo = 0
	f.blocking = false
	local hum = humanoidOf(victim)
	if hum then
		hum.PlatformStand = true
		hum.Sit = true
	end
	local root = rootOf(victim)
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 40, 0)
	end
	local ap = DataService.get(attacker)
	if ap then
		ap.knockouts += 1
		DataService.markDirty(attacker)
	end
	Remotes.Notify:FireClient(victim, { text = "K.O.! Você foi nocauteado por " .. attacker.DisplayName .. "!", color = Color3.fromRGB(255, 80, 80) })
	Remotes.Notify:FireClient(attacker, { text = "NOCAUTE em " .. victim.DisplayName .. "!", color = Color3.fromRGB(255, 200, 60) })
	Remotes.CombatEvent:FireAllClients({ kind = "KO", attacker = attacker.UserId, victim = victim.UserId })
	if CombatService.OnKO then
		CombatService.OnKO(attacker, victim)
	end
	push(victim)
	task.delay(C.KOSeconds, function()
		local h = humanoidOf(victim)
		if h then
			h.PlatformStand = false
			h.Sit = false
		end
		push(victim)
	end)
end

local function tryPunch(attacker: Player, heavy: boolean)
	local f = getFighter(attacker)
	local now = os.clock()
	if f.koUntil > now then
		return
	end
	local cd = if heavy then C.HeavyCooldown else C.PunchCooldown
	local last = if heavy then f.lastHeavy else f.lastPunch
	if now - last < cd then
		return
	end
	local cost = if heavy then C.StaminaHeavy else C.StaminaPunch
	local infinite = f.infiniteStaminaUntil > now
	if not infinite and f.stamina < cost then
		Remotes.Notify:FireClient(attacker, { text = "Sem stamina!", color = Color3.fromRGB(255, 120, 80) })
		return
	end
	if heavy then
		f.lastHeavy = now
	else
		f.lastPunch = now
	end
	if not infinite then
		f.stamina -= cost
	end
	f.blocking = false

	local root = rootOf(attacker)
	if not root then
		return
	end
	local range = if heavy then C.HeavyRange else C.PunchRange
	local origin = root.Position
	local look = root.CFrame.LookVector
	Remotes.CombatEvent:FireAllClients({ kind = "Swing", attacker = attacker.UserId, heavy = heavy })

	local profile = DataService.get(attacker)
	local dmgMult = 1
	if profile and profile.passes.BoxerPro then
		dmgMult = 1.25
	end

	-- Encontra a melhor vítima no cone à frente
	local best: Player? = nil
	local bestDot = 0.45
	for _, other in Players:GetPlayers() do
		if other == attacker then
			continue
		end
		local oroot = rootOf(other)
		if not oroot then
			continue
		end
		local delta = oroot.Position - origin
		local dist = delta.Magnitude
		if dist > range then
			continue
		end
		local dot = if dist < 1 then 1 else look:Dot(delta.Unit)
		if dot > bestDot then
			bestDot = dot
			best = other
		end
	end
	if not best then
		push(attacker)
		return
	end
	local victim: Player = best
	if inOwnSafeZone(victim) then
		Remotes.Notify:FireClient(attacker, { text = victim.DisplayName .. " está na zona segura do próprio pátio.", color = Color3.fromRGB(120, 200, 255) })
		push(attacker)
		return
	end
	local vf = getFighter(victim)
	if vf.koUntil > now then
		push(attacker)
		return
	end

	-- Combo
	if now - f.comboAt <= C.ComboWindow then
		f.combo = math.min(5, f.combo + 1)
	else
		f.combo = 1
	end
	f.comboAt = now

	local dmg = (if heavy then C.HeavyDamage else C.PunchDamage) * dmgMult * (1 + (f.combo - 1) * C.ComboDamageBonus)
	local kb = if heavy then C.HeavyKnockback else C.Knockback
	local blocked = false
	if vf.blocking then
		if heavy and C.BlockBreakHeavy then
			vf.blocking = false
			Remotes.Notify:FireClient(victim, { text = "Guarda QUEBRADA!", color = Color3.fromRGB(255, 120, 80) })
		else
			dmg *= C.BlockDamageMult
			kb *= 0.3
			blocked = true
		end
	end
	vf.hp = math.max(0, vf.hp - dmg)
	vf.lastHitBy = attacker

	local vroot = rootOf(victim)
	if vroot then
		local dir = (vroot.Position - origin)
		dir = if dir.Magnitude < 0.1 then look else dir.Unit
		vroot.AssemblyLinearVelocity = dir * kb + Vector3.new(0, if heavy then 35 else 18, 0)
		hitFx(vroot.Position + Vector3.new(0, 1, 0), heavy)
	end
	if profile then
		profile.punchesLanded += 1
	end
	Remotes.CombatEvent:FireAllClients({ kind = "Hit", attacker = attacker.UserId, victim = victim.UserId, heavy = heavy, blocked = blocked, combo = f.combo })
	if CombatService.OnHit then
		CombatService.OnHit(attacker, victim, heavy)
	end
	if vf.hp <= 0 then
		knockout(victim, attacker)
	end
	push(attacker)
	push(victim)
end

local function setBlock(player: Player, on: boolean)
	local f = getFighter(player)
	if f.koUntil > os.clock() then
		return
	end
	f.blocking = on and f.stamina > 5
	push(player)
end

function CombatService.init()
	Remotes.RequestPunch.OnServerEvent:Connect(function(player, heavy)
		tryPunch(player, heavy == true)
	end)
	Remotes.RequestBlock.OnServerEvent:Connect(function(player, on)
		setBlock(player, on == true)
	end)

	Players.PlayerRemoving:Connect(function(player)
		fighters[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			local f = getFighter(player)
			f.hp = C.KOHealth
			f.koUntil = 0
			f.blocking = false
			task.wait(0.5)
			push(player)
		end)
	end)

	-- Regen de stamina / HP e consumo do bloqueio
	task.spawn(function()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for player, f in fighters do
				if not player.Parent then
					continue
				end
				local max = CombatService.maxStamina(player)
				local changed = false
				if f.blocking then
					if f.infiniteStaminaUntil <= now then
						f.stamina = math.max(0, f.stamina - C.StaminaBlockPerSec * 0.25)
					end
					if f.stamina <= 0 then
						f.blocking = false
					end
					changed = true
				elseif f.stamina < max then
					f.stamina = math.min(max, f.stamina + C.StaminaRegenPerSec * 0.25)
					changed = true
				end
				if f.hp < C.KOHealth and now - f.comboAt > 3 and f.koUntil <= now then
					f.hp = math.min(C.KOHealth, f.hp + 4)
					changed = true
				end
				if changed then
					push(player)
				end
			end
		end
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- DataService — carrega/salva perfis com DataStore, com retry e autosave.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(game.ReplicatedStorage.Shared.Config)

local STORE_NAME = "FeedAGiant_v1"
local store = DataStoreService:GetDataStore(STORE_NAME)
local leaderLevel = DataStoreService:GetOrderedDataStore("FAG_TopLevel_v1")
local leaderRebirth = DataStoreService:GetOrderedDataStore("FAG_TopRebirth_v1")
local leaderArena = DataStoreService:GetOrderedDataStore("FAG_TopArena_v1")

export type FoodInstance = { id: string, uid: string }
export type Profile = {
	coins: number,
	level: number,
	xp: number,
	rebirths: number,
	hunger: number,
	inventory: { FoodInstance },
	plot: { [string]: FoodInstance }, -- key = tostring(slotIndex)
	totalFeeds: number,
	totalSteals: number,
	totalBoxes: number,
	dailyStreak: number,
	lastDaily: number,
	redeemedCodes: { [string]: boolean },
	passes: { [string]: boolean },
	shieldUntil: number,
	-- v2
	species: string,
	ownedSpecies: { [string]: boolean },
	lastFed: number, -- os.time() da última alimentação (base do decay)
	lastSeen: number,
	freezeUntil: number, -- decay congelado até
	levelsLostToDecay: number,
	peakLevel: number,
	dropsWon: number,
	punchesLanded: number,
	knockouts: number,
	arenaWins: number,
	arenaLosses: number,
	arenaStreak: number,
	championships: number,
	championUntil: number,
	lastDuel: number,
	duelProtectionUntil: number,
}

local DataService = {}
local profiles: { [Player]: Profile } = {}
local dirty: { [Player]: boolean } = {}
local uidCounter = 0

function DataService.newUid(): string
	uidCounter += 1
	return string.format("%d_%d", os.time(), uidCounter)
end

local function defaultProfile(): Profile
	return {
		coins = Config.StartingCoins,
		level = 1,
		xp = 0,
		rebirths = 0,
		hunger = 60,
		inventory = {},
		plot = {},
		totalFeeds = 0,
		totalSteals = 0,
		totalBoxes = 0,
		dailyStreak = 0,
		lastDaily = 0,
		redeemedCodes = {},
		passes = {},
		shieldUntil = 0,
		species = Config.DefaultSpecies,
		ownedSpecies = { [Config.DefaultSpecies] = true },
		lastFed = os.time(),
		lastSeen = os.time(),
		freezeUntil = 0,
		levelsLostToDecay = 0,
		peakLevel = 1,
		dropsWon = 0,
		punchesLanded = 0,
		knockouts = 0,
		arenaWins = 0,
		arenaLosses = 0,
		arenaStreak = 0,
		championships = 0,
		championUntil = 0,
		lastDuel = 0,
		duelProtectionUntil = 0,
	}
end

local function withRetry<T>(fn: () -> T, attempts: number): (boolean, T?)
	local ok, result
	for i = 1, attempts do
		ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn("[DataService] tentativa " .. i .. " falhou:", result)
		task.wait(1.5 * i)
	end
	return false, nil
end

local function load(player: Player)
	local key = "u_" .. player.UserId
	local ok, data = withRetry(function()
		return store:GetAsync(key)
	end, 3)
	local profile = defaultProfile()
	if ok and type(data) == "table" then
		for k, v in data :: any do
			(profile :: any)[k] = v
		end
		-- Migração v1 -> v2: perfis antigos não têm os campos novos; defaultProfile já os preencheu.
		if not Config.SpeciesById[profile.species] then
			profile.species = Config.DefaultSpecies
		end
		profile.ownedSpecies[profile.species] = true
		if profile.peakLevel < profile.level then
			profile.peakLevel = profile.level
		end
	end
	if not ok and not RunService:IsStudio() then
		warn("[DataService] Falha ao carregar " .. player.Name .. ". Jogando com perfil temporário.")
	end
	profiles[player] = profile
end

local function save(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local key = "u_" .. player.UserId
	profile.lastSeen = os.time()
	withRetry(function()
		store:SetAsync(key, profile, { player.UserId })
		return true
	end, 3)
	pcall(function()
		leaderLevel:SetAsync(tostring(player.UserId), profile.level + profile.rebirths * 1000)
		leaderRebirth:SetAsync(tostring(player.UserId), profile.rebirths)
		leaderArena:SetAsync(tostring(player.UserId), profile.arenaWins + profile.championships * 10)
	end)
	dirty[player] = nil
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

function DataService.waitFor(player: Player, timeout: number?): Profile?
	local t0 = os.clock()
	while not profiles[player] do
		if os.clock() - t0 > (timeout or 15) then
			return nil
		end
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.markDirty(player: Player)
	dirty[player] = true
end

function DataService.getLeaderboard(kind: "Level" | "Rebirth" | "Arena", n: number): { { userId: number, value: number } }
	local ds = if kind == "Level" then leaderLevel elseif kind == "Arena" then leaderArena else leaderRebirth
	local ok, pages = pcall(function()
		return ds:GetSortedAsync(false, n)
	end)
	local out = {}
	if ok and pages then
		for _, entry in pages:GetCurrentPage() do
			table.insert(out, { userId = tonumber(entry.key) or 0, value = entry.value })
		end
	end
	return out
end

function DataService.init()
	Players.PlayerAdded:Connect(load)
	for _, p in Players:GetPlayers() do
		task.spawn(load, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
	end)
	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		local jobs = {}
		for player in profiles do
			table.insert(jobs, task.spawn(save, player))
		end
		task.wait(3)
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for player in dirty do
				if player.Parent then
					task.spawn(save, player)
				end
			end
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DropService</string>
            <string name="Source"><![CDATA[--!strict
-- DropService — COMIDA CAI DO CÉU e precisa ser DEFENDIDA.
-- Um círculo aparece no chão. Quem fica dentro acumula progresso; o tempo necessário depende da raridade.
-- Socos empurram rivais para fora (e eles perdem metade do progresso). Quem fecha a barra leva a comida.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local CombatService = require(script.Parent.CombatService)

local DropService = {}
local D = Config.Drops

type Drop = {
	id: number,
	food: Config.FoodDef,
	pos: Vector3,
	model: Model,
	ring: Part,
	label: TextLabel,
	holdTime: number,
	progress: { [Player]: number },
	inside: { [Player]: boolean },
	landedAt: number,
	done: boolean,
}

local drops: { [number]: Drop } = {}
local nextId = 0
local folder: Folder

local function activeCount(): number
	local n = 0
	for _ in drops do
		n += 1
	end
	return n
end

local function rollFood(): Config.FoodDef
	local weights = table.clone(D.Weights)
	if #Players:GetPlayers() < D.MinPlayersForRare then
		weights.Legendary = nil
		weights.Mythic = nil
		weights.Secret = nil
	end
	local rarity = Util.weightedPick(weights, 0)
	local pool = {}
	for _, f in Config.Foods do
		if f.rarity == rarity then
			table.insert(pool, f)
		end
	end
	if #pool == 0 then
		return Config.Foods[1]
	end
	return pool[math.random(1, #pool)]
end

local function buildDropModel(food: Config.FoodDef, pos: Vector3): (Model, Part, TextLabel)
	local model = Instance.new("Model")
	model.Name = "Drop_" .. food.id
	local rar = Config.Rarities[food.rarity]
	local body = Util.makePart({
		Name = "Body",
		Size = Vector3.new(4, 4, 4),
		Color = food.color,
		Material = if rar.order >= 4 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		CFrame = CFrame.new(pos + Vector3.new(0, D.FallHeight, 0)),
		CanCollide = false,
		Parent = model,
	})
	body.Shape = if food.shape == "Ball" then Enum.PartType.Ball elseif food.shape == "Cylinder" then Enum.PartType.Cylinder else Enum.PartType.Block
	local light = Instance.new("PointLight")
	light.Color = rar.color
	light.Range = 12 + rar.order * 3
	light.Brightness = 2
	light.Parent = body
	local trail = Instance.new("ParticleEmitter")
	trail.Color = ColorSequence.new(rar.color)
	trail.Rate = 40
	trail.Lifetime = NumberRange.new(0.5, 1)
	trail.Speed = NumberRange.new(2, 5)
	trail.Size = NumberSequence.new(1.5, 0)
	trail.LightEmission = 1
	trail.Parent = body
	model.PrimaryPart = body

	local ring = Util.makePart({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, D.ZoneRadius * 2, D.ZoneRadius * 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rar.color,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	local label = Util.makeBillboard(ring, "", UDim2.fromOffset(320, 90), Vector3.new(0, 10, 0), rar.color)
	label.Text = string.format("%s\n%s — caindo!", food.name, food.rarity)
	return model, ring, label
end

local function award(drop: Drop, winner: Player)
	drop.done = true
	drops[drop.id] = nil
	local profile = DataService.get(winner)
	if profile then
		profile.dropsWon += 1
		DataService.markDirty(winner)
	end
	PlotService.giveFood(winner, drop.food.id)
	local rar = Config.Rarities[drop.food.rarity]
	Remotes.Notify:FireClient(winner, { text = "Você DEFENDEU e ganhou " .. drop.food.name .. "!", color = rar.color })
	if rar.order >= 3 then
		Remotes.Notify:FireAllClients({ text = winner.DisplayName .. " venceu a disputa por " .. drop.food.name .. " (" .. drop.food.rarity .. ")!", color = rar.color })
	end
	Remotes.DropState:FireAllClients({ id = drop.id, removed = true })
	-- efeito de coleta
	local body = drop.model.PrimaryPart
	if body then
		task.spawn(function()
			for i = 1, 10 do
				body.CFrame = body.CFrame * CFrame.new(0, 1.5, 0)
				body.Transparency = i / 10
				task.wait(0.03)
			end
			drop.model:Destroy()
		end)
	else
		drop.model:Destroy()
	end
end

local function expire(drop: Drop)
	drop.done = true
	drops[drop.id] = nil
	Remotes.DropState:FireAllClients({ id = drop.id, removed = true })
	drop.model:Destroy()
end

local function broadcastState(drop: Drop)
	local list = {}
	for plr, prog in drop.progress do
		if plr.Parent then
			table.insert(list, { userId = plr.UserId, name = plr.DisplayName, progress = prog / drop.holdTime, inside = drop.inside[plr] == true })
		end
	end
	table.sort(list, function(a, b)
		return a.progress > b.progress
	end)
	Remotes.DropState:FireAllClients({
		id = drop.id,
		foodId = drop.food.id,
		name = drop.food.name,
		rarity = drop.food.rarity,
		pos = drop.pos,
		holdTime = drop.holdTime,
		contenders = list,
	})
end

local function runDrop(drop: Drop)
	-- Aviso no chão antes de cair
	drop.label.Text = string.format("%s (%s)\nCaindo em %ds!", drop.food.name, drop.food.rarity, D.WarnBeforeFall)
	Remotes.Notify:FireAllClients({ text = "Um(a) " .. drop.food.name .. " [" .. drop.food.rarity .. "] vai cair no centro! Defenda por " .. drop.holdTime .. "s para ficar com ele(a)!", color = Config.Rarities[drop.food.rarity].color })
	broadcastState(drop)
	task.wait(D.WarnBeforeFall)
	if drop.done then
		return
	end
	-- Queda
	local body = drop.model.PrimaryPart :: Part
	local t0 = os.clock()
	local startY = D.FallHeight
	while os.clock() - t0 < D.FallTime do
		local a = (os.clock() - t0) / D.FallTime
		a = a * a -- aceleração
		body.CFrame = CFrame.new(drop.pos + Vector3.new(0, startY * (1 - a) + 2.5, 0)) * CFrame.Angles(a * 6, a * 9, 0)
		task.wait()
	end
	body.CFrame = CFrame.new(drop.pos + Vector3.new(0, 2.5, 0))
	drop.landedAt = os.clock()
	Remotes.CombatEvent:FireAllClients({ kind = "Impact", pos = drop.pos })

	-- Disputa
	local lastBroadcast = 0
	local emptySince = os.clock()
	while not drop.done do
		local dt = task.wait(0.2)
		local anyone = false
		for _, plr in Players:GetPlayers() do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end
			local flat = Vector3.new(root.Position.X - drop.pos.X, 0, root.Position.Z - drop.pos.Z)
			local isIn = flat.Magnitude <= D.ZoneRadius and not CombatService.isKO(plr)
			local wasIn = drop.inside[plr] == true
			if isIn then
				anyone = true
				drop.inside[plr] = true
				drop.progress[plr] = math.min(drop.holdTime, (drop.progress[plr] or 0) + dt)
				if drop.progress[plr] >= drop.holdTime then
					award(drop, plr)
					return
				end
			else
				drop.inside[plr] = nil
				if wasIn and drop.progress[plr] then
					drop.progress[plr] = drop.progress[plr] * (1 - D.ProgressLossWhenOut)
					Remotes.Notify:FireClient(plr, { text = "Saiu do círculo! Perdeu metade do progresso.", color = Color3.fromRGB(255, 120, 80) })
				end
			end
		end
		if anyone then
			emptySince = os.clock()
		elseif os.clock() - emptySince > D.ExpireIfNobody then
			expire(drop)
			return
		end
		-- Label do mundo: líder atual
		local leader: Player? = nil
		local lp = 0
		for plr, prog in drop.progress do
			if prog > lp then
				lp = prog
				leader = plr
			end
		end
		if leader then
			drop.label.Text = string.format("%s (%s)\n%s está defendendo: %d%%", drop.food.name, drop.food.rarity, leader.DisplayName, math.floor(lp / drop.holdTime * 100))
		else
			drop.label.Text = string.format("%s (%s)\nENTRE NO CÍRCULO E DEFENDA!", drop.food.name, drop.food.rarity)
		end
		if os.clock() - lastBroadcast > 0.4 then
			lastBroadcast = os.clock()
			broadcastState(drop)
		end
		body.CFrame = body.CFrame * CFrame.Angles(0, 0.04, 0)
	end
end

function DropService.spawn(forceRarity: string?)
	if activeCount() >= D.MaxActive then
		return
	end
	local food = rollFood()
	if forceRarity then
		local pool = {}
		for _, f in Config.Foods do
			if f.rarity == forceRarity then
				table.insert(pool, f)
			end
		end
		if #pool > 0 then
			food = pool[math.random(1, #pool)]
		end
	end
	-- posição aleatória na ilha central, fora da loja
	local a = math.random() * math.pi * 2
	local r = 35 + math.random() * 45
	local pos = Vector3.new(math.cos(a) * r, 2.5, math.sin(a) * r)
	nextId += 1
	local model, ring, label = buildDropModel(food, pos)
	model.Parent = folder
	local drop: Drop = {
		id = nextId,
		food = food,
		pos = pos,
		model = model,
		ring = ring,
		label = label,
		holdTime = D.HoldTimeByRarity[food.rarity] or 10,
		progress = {},
		inside = {},
		landedAt = 0,
		done = false,
	}
	drops[drop.id] = drop
	task.spawn(function()
		local ok, err = pcall(runDrop, drop)
		if not ok then
			warn("[DropService]", err)
			if not drop.done then
				expire(drop)
			end
		end
	end)
end

function DropService.init()
	folder = Instance.new("Folder")
	folder.Name = "Drops"
	folder.Parent = Workspace

	-- Quem é nocauteado dentro do círculo perde TODO o progresso daquele drop
	local prevKO = CombatService.OnKO
	CombatService.OnKO = function(attacker: Player, victim: Player)
		if prevKO then
			prevKO(attacker, victim)
		end
		for _, drop in drops do
			if drop.progress[victim] and drop.progress[victim] > 0 then
				drop.progress[victim] = 0
				drop.inside[victim] = nil
				Remotes.Notify:FireClient(victim, { text = "Nocauteado! Progresso da disputa zerado.", color = Color3.fromRGB(255, 80, 80) })
			end
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		for _, drop in drops do
			drop.progress[player] = nil
			drop.inside[player] = nil
		end
	end)

	task.spawn(function()
		task.wait(20)
		while true do
			if #Players:GetPlayers() > 0 then
				DropService.spawn()
			end
			local scale = math.clamp(#Players:GetPlayers() / 4, 0.7, 1.6)
			task.wait(math.random(D.MinInterval, D.MaxInterval) / scale)
		end
	end)
end

return DropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- EventService — eventos globais de servidor (Golden Hour, Chuva de Comida, Boss Faminto, Lucky Boxes).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local ShopService = require(script.Parent.ShopService)
local GiantService = require(script.Parent.GiantService)

local EventService = {}
local active: string? = nil

local function broadcast(def)
	Remotes.EventStarted:FireAllClients({ id = def.id, name = def.name, duration = def.duration, color = def.color })
end

local function runGoldenHour(def)
	PlotService.setGlobalMultiplier(2)
	task.wait(def.duration)
	PlotService.setGlobalMultiplier(1)
end

local function runLuckyBoxes(def)
	ShopService.setLuckBonus(0.5)
	task.wait(def.duration)
	ShopService.setLuckBonus(0)
end

local function runFoodRain(def)
	local folder = Instance.new("Folder")
	folder.Name = "FoodRain"
	folder.Parent = Workspace
	local t0 = os.clock()
	while os.clock() - t0 < def.duration do
		local pool = {}
		for _, f in Config.Foods do
			if f.rarity == "Common" or f.rarity == "Uncommon" or (f.rarity == "Rare" and math.random() < 0.15) then
				table.insert(pool, f)
			end
		end
		local food = pool[math.random(1, #pool)]
		local a = math.random() * math.pi * 2
		local r = math.random() * 80
		local p = Util.makePart({
			Name = "Drop",
			Anchored = false,
			Size = Vector3.new(2.5, 2.5, 2.5),
			Color = food.color,
			Material = Enum.Material.Neon,
			CFrame = CFrame.new(math.cos(a) * r, 120, math.sin(a) * r),
			Parent = folder,
		})
		p.Shape = Enum.PartType.Ball
		Util.makeBillboard(p, food.name, UDim2.fromOffset(120, 36), Vector3.new(0, 2, 0), Config.Rarities[food.rarity].color)
		local taken = false
		p.Touched:Connect(function(hit)
			if taken then
				return
			end
			local plr = Players:GetPlayerFromCharacter(hit.Parent)
			if plr then
				taken = true
				p:Destroy()
				PlotService.giveFood(plr, food.id)
				Remotes.Notify:FireClient(plr, { text = "Pegou " .. food.name .. " da chuva!", color = Color3.fromRGB(80, 200, 255) })
			end
		end)
		task.delay(25, function()
			if p.Parent then
				p:Destroy()
			end
		end)
		task.wait(0.8)
	end
	task.wait(25)
	folder:Destroy()
end

local function runHungryBoss(def)
	local pad = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("EventPad") :: Part?
	local origin = if pad then pad.CFrame * CFrame.new(0, 2, 0) else CFrame.new(0, 3, 60)
	local boss = Instance.new("Model")
	boss.Name = "HungryBoss"
	local body = Util.makePart({
		Name = "Body",
		Size = Vector3.new(14, 18, 10),
		Color = Color3.fromRGB(255, 70, 70),
		Material = Enum.Material.Neon,
		CFrame = origin * CFrame.new(0, 9, 0),
		Parent = boss,
	})
	local head = Util.makePart({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(10, 10, 10),
		Color = Color3.fromRGB(255, 120, 120),
		Material = Enum.Material.SmoothPlastic,
		CFrame = origin * CFrame.new(0, 23, 0),
		Parent = boss,
	})
	boss.PrimaryPart = body
	local label = Util.makeBillboard(head, "BOSS FAMINTO\nClique em mim com comida no inventário!", UDim2.fromOffset(320, 80), Vector3.new(0, 8, 0), Color3.fromRGB(255, 90, 90))
	boss.Parent = Workspace

	local scores: { [Player]: number } = {}
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 40
	click.Parent = body
	click.MouseClick:Connect(function(plr)
		local profile = DataService.get(plr)
		if not profile or #profile.inventory == 0 then
			Remotes.Notify:FireClient(plr, { text = "Você precisa de comida no inventário!", color = Color3.fromRGB(255, 90, 90) })
			return
		end
		local item = table.remove(profile.inventory, 1)
		if not item then
			return
		end
		local d = Config.FoodById[item.id]
		local pts = d and Config.Rarities[d.rarity].xp or 10
		scores[plr] = (scores[plr] or 0) + pts
		profile.coins += pts * 2
		DataService.markDirty(plr)
		PlotService.pushState(plr)
		local s = body.Size
		body.Size = s * 1.03
		label.Text = string.format("BOSS FAMINTO\n%s: %d pts", plr.DisplayName, scores[plr])
	end)

	task.wait(def.duration)
	boss:Destroy()
	local ranking = {}
	for plr, pts in scores do
		table.insert(ranking, { plr = plr, pts = pts })
	end
	table.sort(ranking, function(a, b)
		return a.pts > b.pts
	end)
	for i = 1, math.min(3, #ranking) do
		local plr = ranking[i].plr
		if plr.Parent then
			ShopService.openBox(plr, "legendary", true, "Legendary")
			Remotes.Notify:FireAllClients({ text = plr.DisplayName .. " ficou em #" .. i .. " no Boss Faminto e ganhou uma Legendary!", color = Color3.fromRGB(255, 180, 20) })
		end
	end
end

local RUNNERS = {
	GoldenHour = runGoldenHour,
	LuckyBoxes = runLuckyBoxes,
	FoodRain = runFoodRain,
	HungryBoss = runHungryBoss,
}

function EventService.start(id: string)
	if active then
		return
	end
	local def
	for _, d in Config.Events.List do
		if d.id == id then
			def = d
		end
	end
	if not def then
		return
	end
	active = id
	broadcast(def)
	local ok, err = pcall(RUNNERS[id], def)
	if not ok then
		warn("[EventService]", err)
	end
	Remotes.EventEnded:FireAllClients({ id = id })
	active = nil
end

function EventService.init()
	task.spawn(function()
		task.wait(90)
		while true do
			local list = Config.Events.List
			local pick = list[math.random(1, #list)]
			EventService.start(pick.id)
			task.wait(math.random(Config.Events.MinInterval, Config.Events.MaxInterval))
		end
	end)
	-- Reforça visual dos gigantes de vez em quando (segurança)
	task.spawn(function()
		while true do
			task.wait(30)
			for _, plr in Players:GetPlayers() do
				GiantService.refresh(plr)
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">GiantService</string>
            <string name="Source"><![CDATA[--!strict
-- GiantService v2 — espécies, estágios visuais (Bebê→DEUS), decay por ausência, bônus de retorno.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)

local GiantService = {}
local giants: { [Player]: Model } = {}
local lastStage: { [Player]: string } = {}
GiantService.OnReturnBonus = nil :: ((Player, number) -> ())?

function GiantService.scaleForLevel(level: number): number
	return Config.Giant.BaseScale + level * Config.Giant.ScalePerLevel
end

function GiantService.species(profile: DataService.Profile): Config.SpeciesDef
	return Config.SpeciesById[profile.species] or Config.SpeciesById[Config.DefaultSpecies]
end

function GiantService.isDecayImmune(profile: DataService.Profile): boolean
	return GiantService.species(profile).decayImmune or profile.passes.Guardian == true or profile.freezeUntil > os.time()
end

local function mk(model: Model, anchor: Part, name: string, size: Vector3, offset: Vector3, color: Color3, shape: Enum.PartType?, material: Enum.Material?): Part
	local p = Util.makePart({ Name = name, Size = size, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false, Parent = model })
	if shape then
		p.Shape = shape
	end
	p.CFrame = anchor.CFrame * CFrame.new(offset)
	return p
end

local function buildGiantModel(player: Player, anchor: Part, sp: Config.SpeciesDef): Model
	local model = Instance.new("Model")
	model.Name = "Giant_" .. player.Name
	local skin, body = sp.skin, sp.color
	local shape = sp.bodyShape
	local torso: Part
	if shape == "Beast" then
		torso = mk(model, anchor, "Torso", Vector3.new(2.2, 1.6, 3.2), Vector3.new(0, 2.6, 0), body)
		mk(model, anchor, "Head", Vector3.new(1.6, 1.2, 2.2), Vector3.new(0, 3.2, -2.4), skin)
		mk(model, anchor, "Tail", Vector3.new(0.6, 0.6, 2.4), Vector3.new(0, 2.6, 2.6), body)
		for i, x in { -0.8, 0.8 } do
			mk(model, anchor, "LegF" .. i, Vector3.new(0.7, 1.8, 0.7), Vector3.new(x, 0.9, -1), skin)
			mk(model, anchor, "LegB" .. i, Vector3.new(0.7, 1.8, 0.7), Vector3.new(x, 0.9, 1), skin)
		end
	elseif shape == "Bird" then
		torso = mk(model, anchor, "Torso", Vector3.new(1.8, 2.2, 1.4), Vector3.new(0, 3.2, 0), body, Enum.PartType.Ball)
		mk(model, anchor, "Head", Vector3.new(1.3, 1.3, 1.3), Vector3.new(0, 5, -0.2), skin, Enum.PartType.Ball)
		mk(model, anchor, "Beak", Vector3.new(0.4, 0.3, 0.8), Vector3.new(0, 4.9, -1), Color3.fromRGB(255, 190, 40))
		mk(model, anchor, "WingL", Vector3.new(0.3, 1.6, 2.6), Vector3.new(-1.3, 3.4, 0), body)
		mk(model, anchor, "WingR", Vector3.new(0.3, 1.6, 2.6), Vector3.new(1.3, 3.4, 0), body)
		mk(model, anchor, "LeftLeg", Vector3.new(0.4, 2, 0.4), Vector3.new(-0.5, 1, 0), Color3.fromRGB(255, 190, 40))
		mk(model, anchor, "RightLeg", Vector3.new(0.4, 2, 0.4), Vector3.new(0.5, 1, 0), Color3.fromRGB(255, 190, 40))
	elseif shape == "Dragon" then
		torso = mk(model, anchor, "Torso", Vector3.new(2.4, 2.4, 2.2), Vector3.new(0, 3.6, 0), body)
		mk(model, anchor, "Head", Vector3.new(1.6, 1.4, 2), Vector3.new(0, 5.6, -0.8), skin)
		mk(model, anchor, "Tail", Vector3.new(0.7, 0.7, 3), Vector3.new(0, 3, 2.4), body)
		mk(model, anchor, "WingL", Vector3.new(0.2, 2.6, 3), Vector3.new(-1.9, 4.6, 0.4), skin)
		mk(model, anchor, "WingR", Vector3.new(0.2, 2.6, 3), Vector3.new(1.9, 4.6, 0.4), skin)
		mk(model, anchor, "LeftLeg", Vector3.new(1, 2.4, 1), Vector3.new(-0.7, 1.2, 0), body)
		mk(model, anchor, "RightLeg", Vector3.new(1, 2.4, 1), Vector3.new(0.7, 1.2, 0), body)
	elseif shape == "Robot" then
		torso = mk(model, anchor, "Torso", Vector3.new(2.6, 2.4, 1.4), Vector3.new(0, 3.6, 0), body, nil, Enum.Material.Slate)
		mk(model, anchor, "Head", Vector3.new(1.6, 1.4, 1.4), Vector3.new(0, 5.6, 0), skin, nil, Enum.Material.Slate)
		mk(model, anchor, "LeftArm", Vector3.new(1.2, 2.6, 1.2), Vector3.new(-2, 3.4, 0), skin, nil, Enum.Material.Slate)
		mk(model, anchor, "RightArm", Vector3.new(1.2, 2.6, 1.2), Vector3.new(2, 3.4, 0), skin, nil, Enum.Material.Slate)
		mk(model, anchor, "LeftLeg", Vector3.new(1.1, 2.4, 1.1), Vector3.new(-0.7, 1.2, 0), body, nil, Enum.Material.Slate)
		mk(model, anchor, "RightLeg", Vector3.new(1.1, 2.4, 1.1), Vector3.new(0.7, 1.2, 0), body, nil, Enum.Material.Slate)
	elseif shape == "Slime" then
		torso = mk(model, anchor, "Torso", Vector3.new(2.8, 2.2, 2.8), Vector3.new(0, 1.1, 0), body, Enum.PartType.Ball)
		torso.Transparency = 0.25
		local head = mk(model, anchor, "Head", Vector3.new(1.8, 1.6, 1.8), Vector3.new(0, 2.8, 0), skin, Enum.PartType.Ball)
		head.Transparency = 0.2
	else
		torso = mk(model, anchor, "Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3.5, 0), body)
		mk(model, anchor, "Head", Vector3.new(1.4, 1.4, 1.4), Vector3.new(0, 5.4, 0), skin, Enum.PartType.Ball)
		mk(model, anchor, "LeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3.5, 0), skin)
		mk(model, anchor, "RightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3.5, 0), skin)
		mk(model, anchor, "LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1.5, 0), Color3.fromRGB(60, 60, 120))
		mk(model, anchor, "RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1.5, 0), Color3.fromRGB(60, 60, 120))
	end
	local head = model:FindFirstChild("Head") :: Part
	local hc = head.CFrame
	local hz = -head.Size.Z / 2
	local function face(name: string, size: Vector3, off: Vector3, color: Color3): Part
		local p = Util.makePart({ Name = name, Size = size, Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		p.CFrame = hc * CFrame.new(off)
		return p
	end
	face("EyeL", Vector3.new(0.25, 0.35, 0.1), Vector3.new(-0.3, 0.15, hz), Color3.new(0, 0, 0))
	face("EyeR", Vector3.new(0.25, 0.35, 0.1), Vector3.new(0.3, 0.15, hz), Color3.new(0, 0, 0))
	face("BrowL", Vector3.new(0.4, 0.1, 0.1), Vector3.new(-0.3, 0.45, hz), Color3.new(0, 0, 0))
	face("BrowR", Vector3.new(0.4, 0.1, 0.1), Vector3.new(0.3, 0.45, hz), Color3.new(0, 0, 0))
	face("Mouth", Vector3.new(0.7, 0.25, 0.1), Vector3.new(0, -0.3, hz), Color3.fromRGB(200, 40, 60))
	local teeth = face("Teeth", Vector3.new(0.6, 0.1, 0.1), Vector3.new(0, -0.22, hz - 0.02), Color3.new(1, 1, 1))
	teeth.Transparency = 1
	for i, x in { -0.45, 0.45 } do
		local horn = Util.makePart({ Name = "Horn" .. i, Size = Vector3.new(0.3, 0.8, 0.3), Color = Color3.fromRGB(240, 230, 200), CanCollide = false, Parent = model })
		horn.CFrame = hc * CFrame.new(x, head.Size.Y / 2 + 0.3, 0) * CFrame.Angles(0, 0, math.rad(-x * 40))
		horn.Transparency = 1
	end
	model.PrimaryPart = torso

	local label = Util.makeBillboard(torso, "", UDim2.fromOffset(260, 80), Vector3.new(0, 4, 0))
	label.Parent.Name = "InfoGui"
	label.Name = "Info"

	local fx = Instance.new("ParticleEmitter")
	fx.Name = "FeedFX"
	fx.Rate = 0
	fx.Lifetime = NumberRange.new(0.6, 1.2)
	fx.Speed = NumberRange.new(6, 12)
	fx.SpreadAngle = Vector2.new(180, 180)
	fx.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80))
	fx.Size = NumberSequence.new(0.8, 0)
	fx.Parent = torso

	local aura = Instance.new("ParticleEmitter")
	aura.Name = "Aura"
	aura.Rate = 0
	aura.Lifetime = NumberRange.new(1, 2)
	aura.Speed = NumberRange.new(1, 3)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.LightEmission = 1
	aura.Size = NumberSequence.new(1.5, 0)
	aura.Parent = torso
	local light = Instance.new("PointLight")
	light.Name = "AuraLight"
	light.Brightness = 0
	light.Range = 30
	light.Parent = torso

	model.Parent = Workspace
	return model
end

local function applyStage(model: Model, stage: Config.StageDef, profile: DataService.Profile)
	for _, n in { "EyeL", "EyeR" } do
		local e = model:FindFirstChild(n) :: Part?
		if e then
			e.Color = stage.eyeColor
		end
	end
	local head = model:FindFirstChild("Head") :: Part?
	if head then
		for sign, n in { [-1] = "BrowL", [1] = "BrowR" } do
			local b = model:FindFirstChild(n) :: Part?
			if b then
				b.CFrame = head.CFrame * CFrame.new(sign * 0.3, 0.45, -head.Size.Z / 2) * CFrame.Angles(0, 0, math.rad(stage.browAngle * sign))
			end
		end
	end
	local mouth = model:FindFirstChild("Mouth") :: Part?
	if mouth then
		mouth.Size = Vector3.new(0.7 * stage.mouthWidth * 2, 0.25, 0.1)
	end
	local teeth = model:FindFirstChild("Teeth") :: Part?
	if teeth then
		teeth.Transparency = if stage.teeth then 0 else 1
	end
	for i = 1, 2 do
		local h = model:FindFirstChild("Horn" .. i) :: Part?
		if h then
			h.Transparency = if stage.horns then 0 else 1
		end
	end
	local torso = model.PrimaryPart
	if torso then
		local aura = torso:FindFirstChild("Aura") :: ParticleEmitter?
		local light = torso:FindFirstChild("AuraLight") :: PointLight?
		local color = stage.aura
		if profile.passes.Guardian then
			color = Color3.fromRGB(255, 215, 0)
		end
		if profile.championUntil > os.time() then
			color = Color3.fromRGB(255, 255, 255)
		end
		if aura and light then
			if color then
				aura.Color = ColorSequence.new(color)
				aura.Rate = 25
				light.Color = color
				light.Brightness = 2
			else
				aura.Rate = 0
				light.Brightness = 0
			end
		end
	end
end

local function refreshVisual(player: Player, pulse: boolean)
	local model = giants[player]
	local profile = DataService.get(player)
	if not model or not profile then
		return
	end
	local scale = GiantService.scaleForLevel(profile.level)
	model:ScaleTo(1)
	local stage = Config.stageForLevel(profile.level)
	applyStage(model, stage, profile)
	if pulse then
		Util.tweenScale(model, scale, 0.6)
	else
		model:ScaleTo(scale)
	end
	local sp = GiantService.species(profile)
	local torso = model.PrimaryPart
	if torso then
		local info = torso:FindFirstChild("InfoGui") :: BillboardGui?
		local lbl = info and info:FindFirstChild("Info") :: TextLabel?
		if lbl then
			local tag = if profile.championUntil > os.time() then "  👑" else ""
			lbl.Text = string.format("%s%s\n%s • %s\nLv. %d • %s", player.DisplayName, tag, sp.name, stage.name, profile.level, GiantService.mood(profile))
			lbl.TextColor3 = sp.color
		end
		if info then
			info.StudsOffset = Vector3.new(0, 4 * scale, 0)
			info.Size = UDim2.fromOffset(260 + scale * 10, 100 + scale * 3)
		end
	end
	if lastStage[player] and lastStage[player] ~= stage.name and Config.stageForLevel(profile.level).minLevel > 1 then
		Remotes.GiantEvolved:FireAllClients({ userId = player.UserId, stageName = stage.name, level = profile.level })
		Remotes.Notify:FireAllClients({ text = player.DisplayName .. " evoluiu seu Gigante para " .. string.upper(stage.name) .. "!", color = stage.eyeColor })
	end
	lastStage[player] = stage.name
end

function GiantService.mood(profile: DataService.Profile): string
	if profile.hunger < 30 then
		return "Faminto"
	elseif profile.hunger < 75 then
		return "Satisfeito"
	end
	return "Feliz"
end

function GiantService.moodMultiplier(profile: DataService.Profile): number
	local m = GiantService.mood(profile)
	if m == "Faminto" then
		return Config.Giant.MoodMultipliers.Hungry
	elseif m == "Feliz" then
		return Config.Giant.MoodMultipliers.Happy
	end
	return Config.Giant.MoodMultipliers.Fine
end

function GiantService.addXp(player: Player, amount: number)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if profile.passes.VIP then
		amount = math.floor(amount * 1.5)
	end
	amount = math.floor(amount * GiantService.species(profile).xpMult)
	profile.xp += amount
	profile.hunger = math.min(100, profile.hunger + Config.Giant.HungerPerFeed)
	profile.lastFed = os.time()
	local leveled = false
	while profile.level < Config.Giant.MaxLevel and profile.xp >= Config.xpNeeded(profile.level) do
		profile.xp -= Config.xpNeeded(profile.level)
		profile.level += 1
		leveled = true
	end
	profile.peakLevel = math.max(profile.peakLevel, profile.level)
	DataService.markDirty(player)
	local model = giants[player]
	local fx = model and model.PrimaryPart and model.PrimaryPart:FindFirstChild("FeedFX") :: ParticleEmitter?
	if fx then
		fx:Emit(20)
	end
	refreshVisual(player, true)
	Remotes.GiantFed:FireAllClients({ userId = player.UserId, xp = amount, leveled = leveled })
	if leveled then
		Remotes.Notify:FireClient(player, { text = "Seu Gigante subiu para o nível " .. profile.level .. "!", color = Color3.fromRGB(255, 220, 80) })
	end
end

-- Decay por ausência (chamado ao entrar). Retorna níveis perdidos.
function GiantService.applyDecay(player: Player, profile: DataService.Profile): number
	local D = Config.Decay
	local away = os.time() - math.max(profile.lastFed, profile.lastSeen)
	if away >= 86400 then
		-- bônus de retorno (independe do decay)
		profile.coins += D.ReturnBonusCoins
		if GiantService.OnReturnBonus then
			GiantService.OnReturnBonus(player, away)
		end
		Remotes.Notify:FireClient(player, { text = "Bem-vindo de volta! +" .. D.ReturnBonusCoins .. " moedas e uma Lunchbox de presente.", color = Color3.fromRGB(120, 255, 160) })
	end
	if GiantService.isDecayImmune(profile) or away <= D.GraceSeconds then
		return 0
	end
	local days = (away - D.GraceSeconds) / 86400
	local lost = math.min(D.MaxLevelsLost, math.floor(days * D.LevelsLostPerDay), profile.level - 1)
	if lost <= 0 then
		return 0
	end
	profile.level -= lost
	profile.xp = 0
	profile.levelsLostToDecay += lost
	profile.hunger = 10
	DataService.markDirty(player)
	Remotes.Notify:FireClient(player, { text = "Seu Gigante ficou " .. math.floor(days + 3) .. " dias sem comer e ENCOLHEU " .. lost .. " níveis! (Recupere na Loja)", color = Color3.fromRGB(255, 90, 90) })
	return lost
end

function GiantService.setSpecies(player: Player, speciesId: string): boolean
	local profile = DataService.get(player)
	if not profile or not Config.SpeciesById[speciesId] or not profile.ownedSpecies[speciesId] then
		return false
	end
	profile.species = speciesId
	DataService.markDirty(player)
	GiantService.spawnFor(player)
	return true
end

function GiantService.onPassesChanged(player: Player)
	local profile = DataService.get(player)
	if profile then
		for _, sp in Config.Species do
			if sp.robux and sp.passKey and profile.passes[sp.passKey] then
				profile.ownedSpecies[sp.id] = true
			end
		end
	end
	refreshVisual(player, false)
end

function GiantService.spawnFor(player: Player)
	local base = MapService.getBaseOf(player)
	local profile = DataService.get(player)
	if not base or not profile then
		return
	end
	if giants[player] then
		giants[player]:Destroy()
	end
	local model = buildGiantModel(player, base.giantAnchor, GiantService.species(profile))
	model:SetAttribute("OwnerUserId", player.UserId)
	giants[player] = model
	lastStage[player] = nil
	refreshVisual(player, false)
end

function GiantService.getModel(player: Player): Model?
	return giants[player]
end

function GiantService.refresh(player: Player, pulse: boolean?)
	refreshVisual(player, pulse == true)
end

function GiantService.init()
	Players.PlayerRemoving:Connect(function(player)
		if giants[player] then
			giants[player]:Destroy()
			giants[player] = nil
		end
		lastStage[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			for player, _ in giants do
				local profile = DataService.get(player)
				if profile then
					local before = GiantService.mood(profile)
					local mult = GiantService.species(profile).hungerDecayMult
					profile.hunger = math.max(0, profile.hunger - Config.Giant.HungerDecayPerSec * 5 * mult)
					if GiantService.mood(profile) ~= before then
						refreshVisual(player, false)
					end
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(2 + math.random() * 3)
			for _, model in giants do
				local eyeL = model:FindFirstChild("EyeL") :: Part?
				local eyeR = model:FindFirstChild("EyeR") :: Part?
				if eyeL and eyeR then
					eyeL.Transparency = 1
					eyeR.Transparency = 1
					task.delay(0.12, function()
						eyeL.Transparency = 0
						eyeR.Transparency = 0
					end)
				end
			end
		end
	end)
end

return GiantService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- LeaderboardService — atualiza os placares físicos e o leaderstats (lista do Roblox).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Util = require(game.ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local nameCache: { [number]: string } = {}
local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok then name else "???"
	nameCache[userId] = result
	return result
end

local function render(boardName: string, entries: { { userId: number, value: number } }, suffix: string)
	local map = Workspace:FindFirstChild("Map")
	local board = map and map:FindFirstChild(boardName)
	local gui = board and board:FindFirstChildOfClass("SurfaceGui")
	local list = gui and gui:FindFirstChild("List") :: TextLabel?
	if not list then
		return
	end
	local lines = {}
	for i, e in entries do
		table.insert(lines, string.format("#%d  %s — %s%s", i, nameOf(e.userId), Util.formatNumber(e.value), suffix))
	end
	list.Text = if #lines > 0 then table.concat(lines, "\n") else "Seja o primeiro!"
end

local function setupLeaderstats(player: Player)
	local profile = DataService.waitFor(player)
	if not profile then
		return
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local lvl = Instance.new("IntValue")
	lvl.Name = "Giant Lv"
	lvl.Value = profile.level
	lvl.Parent = ls
	local rb = Instance.new("IntValue")
	rb.Name = "Rebirths"
	rb.Value = profile.rebirths
	rb.Parent = ls
	local aw = Instance.new("IntValue")
	aw.Name = "Wins"
	aw.Value = profile.arenaWins
	aw.Parent = ls
	ls.Parent = player
	task.spawn(function()
		while player.Parent do
			task.wait(2)
			local p = DataService.get(player)
			if p then
				lvl.Value = p.level
				rb.Value = p.rebirths
				aw.Value = p.arenaWins
			end
		end
	end)
end

function LeaderboardService.init()
	Players.PlayerAdded:Connect(setupLeaderstats)
	for _, p in Players:GetPlayers() do
		task.spawn(setupLeaderstats, p)
	end
	task.spawn(function()
		while true do
			local lvl = DataService.getLeaderboard("Level", 10)
			for _, e in lvl do
				e.value = e.value % 1000 -- valor salvo = level + rebirths*1000; exibe só o nível
			end
			render("Leaderboard1", lvl, "")
			render("Leaderboard2", DataService.getLeaderboard("Rebirth", 10), " rebirths")
			render("Leaderboard3", DataService.getLeaderboard("Arena", 10), " pts")
			task.wait(120)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
-- MapService — constrói a ilha central, loja, pedestais e as 8 bases 100% por código.
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)

local MapService = {}

export type BaseInfo = {
	index: number,
	model: Model,
	origin: CFrame,
	slots: { Part },
	giantAnchor: Part,
	sign: TextLabel,
	zone: Part,
	owner: Player?,
}

MapService.Bases = {} :: { BaseInfo }
MapService.ShopPad = nil :: Part?
MapService.Center = CFrame.new(0, 0, 0)

local function buildCenterIsland(root: Folder)
	local island = Util.makePart({
		Name = "CenterIsland",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 180, 180),
		CFrame = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(240, 220, 160),
		Material = Enum.Material.Sand,
		Parent = root,
	})
	island.Name = "CenterIsland"

	-- Loja central
	local shop = Util.makePart({
		Name = "ShopPad",
		Size = Vector3.new(24, 1, 24),
		CFrame = CFrame.new(0, 2.5, 0),
		Color = Color3.fromRGB(255, 120, 40),
		Material = Enum.Material.Neon,
		Parent = root,
	})
	MapService.ShopPad = shop
	local shopSign = Util.makePart({
		Name = "ShopSign",
		Size = Vector3.new(26, 8, 2),
		CFrame = CFrame.new(0, 10, -12),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		Parent = root,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.Parent = shopSign
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = "LUNCHBOX SHOP"
	lbl.TextScaled = true
	lbl.Font = Enum.Font.FredokaOne
	lbl.TextColor3 = Color3.fromRGB(255, 120, 40)
	lbl.Parent = gui
	Util.makeBillboard(shop, "LOJA — entre para abrir", UDim2.fromOffset(300, 60), Vector3.new(0, 6, 0), Color3.fromRGB(255, 220, 120))

	-- Pedestal do evento
	local eventPad = Util.makePart({
		Name = "EventPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 30, 30),
		CFrame = CFrame.new(0, 2.5, 60) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 60, 255),
		Material = Enum.Material.Neon,
		Parent = root,
	})
	eventPad.Name = "EventPad"

	-- Leaderboards
	for i, title in { "MAIORES GIGANTES", "MAIS REBIRTHS", "REIS DA ARENA" } do
		local board = Util.makePart({
			Name = "Leaderboard" .. i,
			Size = Vector3.new(18, 24, 2),
			CFrame = CFrame.new(({ -46, 0, 46 })[i], 14, -62),
			Color = Color3.fromRGB(30, 30, 40),
			Material = Enum.Material.SmoothPlastic,
			Parent = root,
		})
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.PixelsPerStud = 25
		sg.Parent = board
		local t = Instance.new("TextLabel")
		t.Name = "Title"
		t.Size = UDim2.fromScale(1, 0.12)
		t.BackgroundTransparency = 1
		t.Text = title
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.TextColor3 = Color3.fromRGB(255, 220, 80)
		t.Parent = sg
		local list = Instance.new("TextLabel")
		list.Name = "List"
		list.Position = UDim2.fromScale(0, 0.14)
		list.Size = UDim2.fromScale(1, 0.86)
		list.BackgroundTransparency = 1
		list.Text = "Carregando..."
		list.TextScaled = true
		list.TextXAlignment = Enum.TextXAlignment.Left
		list.Font = Enum.Font.GothamBold
		list.TextColor3 = Color3.new(1, 1, 1)
		list.Parent = sg
	end

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 2.5, -40)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Parent = root
end

local function buildBase(index: number, root: Folder): BaseInfo
	local angle = (index - 1) / Config.MaxPlayers * math.pi * 2
	local origin = CFrame.new(math.cos(angle) * Config.BaseRadius, 0, math.sin(angle) * Config.BaseRadius)
		* CFrame.Angles(0, -angle + math.pi / 2, 0)

	local model = Instance.new("Model")
	model.Name = "Base" .. index
	model.Parent = root

	local size = Config.BaseSize
	local floor = Util.makePart({
		Name = "Floor",
		Size = Vector3.new(size, 2, size),
		CFrame = origin * CFrame.new(0, 1, 0),
		Color = Color3.fromRGB(90, 90, 110),
		Material = Enum.Material.Slate,
		Parent = model,
	})
	local zone = Util.makePart({
		Name = "Zone",
		Size = Vector3.new(size, 20, size),
		CFrame = origin * CFrame.new(0, 12, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})

	-- Caminho até o centro
	local dir = (Vector3.zero - origin.Position).Unit
	local dist = origin.Position.Magnitude - size / 2 - 88
	Util.makePart({
		Name = "Path",
		Size = Vector3.new(10, 1, dist),
		CFrame = CFrame.lookAt(origin.Position + dir * (size / 2 + dist / 2), Vector3.zero) * CFrame.new(0, 1.5, 0),
		Color = Color3.fromRGB(200, 180, 140),
		Material = Enum.Material.Cobblestone,
		Parent = model,
	})

	-- Pedestal do Gigante (fundo da base)
	local giantAnchor = Util.makePart({
		Name = "GiantAnchor",
		Size = Vector3.new(16, 1, 16),
		CFrame = origin * CFrame.new(0, 2.5, -size / 2 + 14),
		Color = Color3.fromRGB(255, 220, 80),
		Material = Enum.Material.Neon,
		Parent = model,
	})

	-- Slots do pátio (grade 4x4; os 12 primeiros padrão, 4 extras para VIP)
	local slots = {}
	local cols = 4
	local spacing = 9
	local startX = -(cols - 1) * spacing / 2
	for i = 1, Config.PlotSlotsVIP do
		local col = (i - 1) % cols
		local row = math.floor((i - 1) / cols)
		local slot = Util.makePart({
			Name = "Slot" .. i,
			Size = Vector3.new(6, 0.4, 6),
			CFrame = origin * CFrame.new(startX + col * spacing, 2.2, 8 + row * spacing - 10),
			Color = if i <= Config.PlotSlots then Color3.fromRGB(60, 200, 120) else Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.SmoothPlastic,
			Parent = model,
		})
		slot:SetAttribute("SlotIndex", i)
		slot:SetAttribute("BaseIndex", index)
		table.insert(slots, slot)
	end

	-- Placa com nome
	local signPart = Util.makePart({
		Name = "Sign",
		Size = Vector3.new(size, 6, 1),
		CFrame = origin * CFrame.new(0, 10, -size / 2),
		Color = Color3.fromRGB(40, 40, 50),
		Parent = model,
	})
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.Parent = signPart
	local sign = Instance.new("TextLabel")
	sign.Size = UDim2.fromScale(1, 1)
	sign.BackgroundTransparency = 1
	sign.Text = "BASE LIVRE"
	sign.TextScaled = true
	sign.Font = Enum.Font.FredokaOne
	sign.TextColor3 = Color3.new(1, 1, 1)
	sign.Parent = sg

	-- Paredes laterais baixas (decorativas)
	for _, side in { -1, 1 } do
		Util.makePart({
			Name = "Wall",
			Size = Vector3.new(1, 4, size),
			CFrame = origin * CFrame.new(side * size / 2, 4, 0),
			Color = Color3.fromRGB(70, 70, 90),
			Parent = model,
		})
	end

	floor:SetAttribute("BaseIndex", index)
	zone:SetAttribute("BaseIndex", index)

	return {
		index = index,
		model = model,
		origin = origin,
		slots = slots,
		giantAnchor = giantAnchor,
		sign = sign,
		zone = zone,
		owner = nil,
	}
end

function MapService.init()
	local root = Instance.new("Folder")
	root.Name = "Map"
	root.Parent = Workspace
	buildCenterIsland(root)
	for i = 1, Config.MaxPlayers do
		MapService.Bases[i] = buildBase(i, root)
	end

	-- Decoração: nuvens
	for i = 1, 20 do
		local a = math.random() * math.pi * 2
		local r = 150 + math.random() * 400
		Util.makePart({
			Name = "Cloud",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(20 + math.random() * 30, 10, 14 + math.random() * 10),
			CFrame = CFrame.new(math.cos(a) * r, 140 + math.random() * 60, math.sin(a) * r),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0.1,
			Parent = root,
		})
	end
end

function MapService.getBaseOf(player: Player): BaseInfo?
	for _, base in MapService.Bases do
		if base.owner == player then
			return base
		end
	end
	return nil
end

function MapService.claimBase(player: Player): BaseInfo?
	for _, base in MapService.Bases do
		if base.owner == nil then
			base.owner = player
			base.sign.Text = string.upper(player.DisplayName) .. "'S GIANT"
			return base
		end
	end
	return nil
end

function MapService.releaseBase(player: Player)
	local base = MapService.getBaseOf(player)
	if base then
		base.owner = nil
		base.sign.Text = "BASE LIVRE"
	end
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- MonetizationService — Game Passes e Developer Products (Robux).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local ShopService = require(script.Parent.ShopService)
local StealService = require(script.Parent.StealService)
local GiantService = require(script.Parent.GiantService)
local CombatService = require(script.Parent.CombatService)

local MonetizationService = {}

local function refreshPasses(player: Player)
	local profile = DataService.waitFor(player)
	if not profile then
		return
	end
	for key, id in Config.GamePasses do
		if id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				profile.passes[key] = true
			end
		end
	end
	GiantService.onPassesChanged(player)
	PlotService.pushState(player)
end

local function grantProduct(player: Player, productId: number): boolean
	local profile = DataService.get(player)
	if not profile then
		return false
	end
	for key, def in Config.DevProducts do
		if def.id == productId then
			if key == "Coins10k" or key == "Coins100k" then
				profile.coins += (def :: any).coins
			elseif key == "SuperShield" then
				StealService.giveShield(player, Config.Steal.SuperShieldSec)
			elseif key == "LuckyBox" then
				ShopService.openBox(player, "rare", true, "Rare")
			elseif key == "FreezeDecay7d" then
				profile.freezeUntil = math.max(os.time(), profile.freezeUntil) + Config.Decay.FreezeProductSeconds
				Remotes.Notify:FireClient(player, { text = "Encolhimento CONGELADO por 7 dias!", color = Color3.fromRGB(120, 220, 255) })
			elseif key == "RestoreLevels" then
				local lost = profile.levelsLostToDecay
				profile.level = math.min(Config.Giant.MaxLevel, profile.level + lost)
				profile.levelsLostToDecay = 0
				GiantService.refresh(player, true)
				Remotes.Notify:FireClient(player, { text = "+" .. lost .. " níveis RESTAURADOS!", color = Color3.fromRGB(255, 220, 80) })
			elseif key == "StaminaRefill" then
				CombatService.refillStamina(player, 60)
				Remotes.Notify:FireClient(player, { text = "Stamina INFINITA por 60s!", color = Color3.fromRGB(255, 200, 60) })
			elseif key == "ArenaRematch" then
				profile.lastDuel = 0
				Remotes.Notify:FireClient(player, { text = "Cooldown de duelo zerado!", color = Color3.fromRGB(255, 120, 120) })
			elseif key == "SpeciesReroll" then
				local pool = {}
				for _, sp in Config.Species do
					if not sp.robux and not profile.ownedSpecies[sp.id] then
						table.insert(pool, sp)
					end
				end
				if #pool > 0 then
					local pick = pool[math.random(1, #pool)]
					profile.ownedSpecies[pick.id] = true
					GiantService.setSpecies(player, pick.id)
					Remotes.Notify:FireClient(player, { text = "Nova espécie desbloqueada: " .. pick.name .. "!", color = pick.color })
				else
					profile.coins += 50000
					Remotes.Notify:FireClient(player, { text = "Você já tem todas as espécies! +50.000 moedas.", color = Color3.fromRGB(255, 220, 80) })
				end
			end
			DataService.markDirty(player)
			PlotService.pushState(player)
			Remotes.Notify:FireClient(player, { text = "Compra recebida. Obrigado!", color = Color3.fromRGB(80, 255, 120) })
			return true
		end
	end
	return false
end

function MonetizationService.init()
	Players.PlayerAdded:Connect(refreshPasses)
	for _, p in Players:GetPlayers() do
		task.spawn(refreshPasses, p)
	end

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local ok = grantProduct(player, receipt.ProductId)
		return if ok then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local profile = DataService.get(player)
			if profile then
				for key, id in Config.GamePasses do
					if id == passId then
						profile.passes[key] = true
					end
				end
				GiantService.onPassesChanged(player)
				DataService.markDirty(player)
				PlotService.pushState(player)
				PlotService.rebuildPlot(player)
			end
		end
	end)

	Remotes.RequestPurchase.OnServerEvent:Connect(function(player, key)
		local def = Config.DevProducts[key]
		if def and def.id ~= 0 then
			MarketplaceService:PromptProductPurchase(player, def.id)
		else
			Remotes.Notify:FireClient(player, { text = "Produto ainda não configurado (ID 0 em Config.lua).", color = Color3.fromRGB(255, 200, 80) })
		end
	end)
	Remotes.RequestGamePass.OnServerEvent:Connect(function(player, key)
		local id = Config.GamePasses[key]
		if id and id ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			Remotes.Notify:FireClient(player, { text = "Game Pass ainda não configurado (ID 0 em Config.lua).", color = Color3.fromRGB(255, 200, 80) })
		end
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!strict
-- PlotService — inventário, slots do pátio, alimentar o Gigante e renda passiva.
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)
local GiantService = require(script.Parent.GiantService)

local PlotService = {}
local foodModels: { [Player]: { [number]: Model } } = {}
local globalCoinMultiplier = 1 -- alterado por EventService (Golden Hour)

function PlotService.setGlobalMultiplier(m: number)
	globalCoinMultiplier = m
end

function PlotService.maxSlots(profile: DataService.Profile): number
	return if profile.passes.VIP then Config.PlotSlotsVIP else Config.PlotSlots
end

function PlotService.pushState(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	Remotes.StateChanged:FireClient(player, {
		coins = profile.coins,
		level = profile.level,
		xp = profile.xp,
		xpNeeded = Config.xpNeeded(profile.level),
		rebirths = profile.rebirths,
		hunger = profile.hunger,
		inventory = profile.inventory,
		plot = profile.plot,
		maxSlots = PlotService.maxSlots(profile),
		cps = PlotService.coinsPerSecond(player),
		passes = profile.passes,
		shieldUntil = profile.shieldUntil,
		dailyStreak = profile.dailyStreak,
		lastDaily = profile.lastDaily,
		-- v2
		species = profile.species,
		ownedSpecies = profile.ownedSpecies,
		stage = Config.stageForLevel(profile.level).name,
		lastFed = profile.lastFed,
		freezeUntil = profile.freezeUntil,
		levelsLostToDecay = profile.levelsLostToDecay,
		peakLevel = profile.peakLevel,
		arenaWins = profile.arenaWins,
		arenaLosses = profile.arenaLosses,
		championUntil = profile.championUntil,
		duelProtectionUntil = profile.duelProtectionUntil,
		lastDuel = profile.lastDuel,
		dropsWon = profile.dropsWon,
		knockouts = profile.knockouts,
	})
end

function PlotService.coinsPerSecond(player: Player): number
	local profile = DataService.get(player)
	if not profile then
		return 0
	end
	local total = 0
	for _, food in profile.plot do
		local def = Config.FoodById[food.id]
		if def then
			total += Config.Rarities[def.rarity].cps
		end
	end
	local sp = GiantService.species(profile)
	local rebirthBonus = Config.Rebirth.BonusPerRebirth * (if sp.id == "phoenix" then 2 else 1)
	local mult = 1 + profile.rebirths * rebirthBonus
	mult *= GiantService.moodMultiplier(profile)
	mult *= sp.coinMult
	mult *= 1 + profile.level * 0.01
	if profile.passes.DoubleCoins then
		mult *= 2
	end
	if Config.GroupId ~= 0 and player:IsInGroup(Config.GroupId) then
		mult *= 1.1
	end
	return math.floor(total * mult * globalCoinMultiplier)
end

local function buildFoodModel(def: Config.FoodDef, slot: Part): Model
	local model = Instance.new("Model")
	model.Name = "Food_" .. def.id
	local p = Util.makePart({
		Name = "Body",
		Size = Vector3.new(3, 3, 3),
		Color = def.color,
		Material = if Config.Rarities[def.rarity].order >= 4 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		CFrame = slot.CFrame * CFrame.new(0, 2, 0),
		Parent = model,
	})
	if def.shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif def.shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(1.2, 3.5, 3.5)
		p.CFrame = slot.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90))
	elseif def.shape == "Wedge" then
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.Size = Vector3.new(3, 2.5, 3)
		w.Color = def.color
		w.Material = p.Material
		w.CFrame = slot.CFrame * CFrame.new(0, 1.6, 0)
		w.Parent = model
		p:Destroy()
		p = w :: any
	end
	model.PrimaryPart = p
	local rc = Config.Rarities[def.rarity].color
	Util.makeBillboard(p, def.name .. "\n" .. def.rarity, UDim2.fromOffset(140, 50), Vector3.new(0, 3, 0), rc)
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 25
	click.Parent = p
	local sel = Instance.new("SelectionBox")
	sel.Adornee = p
	sel.Color3 = rc
	sel.LineThickness = 0.05
	sel.Parent = p
	model:SetAttribute("FoodId", def.id)
	model:SetAttribute("SlotIndex", slot:GetAttribute("SlotIndex"))
	model:SetAttribute("BaseIndex", slot:GetAttribute("BaseIndex"))
	model.Parent = slot.Parent
	return model
end

function PlotService.rebuildPlot(player: Player)
	local profile = DataService.get(player)
	local base = MapService.getBaseOf(player)
	if not profile or not base then
		return
	end
	foodModels[player] = foodModels[player] or {}
	for idx, m in foodModels[player] do
		m:Destroy()
		foodModels[player][idx] = nil
	end
	for key, food in profile.plot do
		local idx = tonumber(key)
		local def = Config.FoodById[food.id]
		if idx and def and base.slots[idx] then
			local model = buildFoodModel(def, base.slots[idx])
			model:SetAttribute("OwnerUserId", player.UserId)
			foodModels[player][idx] = model
		end
	end
end

function PlotService.getFoodModel(player: Player, slot: number): Model?
	return foodModels[player] and foodModels[player][slot]
end

function PlotService.giveFood(player: Player, foodId: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	table.insert(profile.inventory, { id = foodId, uid = DataService.newUid() })
	DataService.markDirty(player)
	PlotService.pushState(player)
end

function PlotService.place(player: Player, invIndex: number)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local item = profile.inventory[invIndex]
	if not item then
		return
	end
	local max = PlotService.maxSlots(profile)
	for i = 1, max do
		if not profile.plot[tostring(i)] then
			profile.plot[tostring(i)] = item
			table.remove(profile.inventory, invIndex)
			DataService.markDirty(player)
			PlotService.rebuildPlot(player)
			PlotService.pushState(player)
			return
		end
	end
	Remotes.Notify:FireClient(player, { text = "Pátio cheio! Alimente seu Gigante para liberar espaço.", color = Color3.fromRGB(255, 90, 90) })
end

function PlotService.pickup(player: Player, slot: number)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local item = profile.plot[tostring(slot)]
	if not item then
		return
	end
	profile.plot[tostring(slot)] = nil
	table.insert(profile.inventory, item)
	DataService.markDirty(player)
	PlotService.rebuildPlot(player)
	PlotService.pushState(player)
end

function PlotService.removeFromPlot(player: Player, slot: number): DataService.FoodInstance?
	local profile = DataService.get(player)
	if not profile then
		return nil
	end
	local item = profile.plot[tostring(slot)]
	if not item then
		return nil
	end
	profile.plot[tostring(slot)] = nil
	DataService.markDirty(player)
	PlotService.rebuildPlot(player)
	PlotService.pushState(player)
	return item
end

function PlotService.feed(player: Player, slot: number)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local item = profile.plot[tostring(slot)]
	if not item then
		return
	end
	local def = Config.FoodById[item.id]
	if not def then
		return
	end
	profile.plot[tostring(slot)] = nil
	profile.totalFeeds += 1
	GiantService.addXp(player, Config.Rarities[def.rarity].xp)
	PlotService.rebuildPlot(player)
	PlotService.pushState(player)
end

function PlotService.feedFromInventory(player: Player, invIndex: number)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local item = profile.inventory[invIndex]
	if not item then
		return
	end
	local def = Config.FoodById[item.id]
	if not def then
		return
	end
	table.remove(profile.inventory, invIndex)
	profile.totalFeeds += 1
	GiantService.addXp(player, Config.Rarities[def.rarity].xp)
	PlotService.pushState(player)
end

function PlotService.init()
	Remotes.RequestPlace.OnServerEvent:Connect(function(player, invIndex)
		if type(invIndex) == "number" then
			PlotService.place(player, invIndex)
		end
	end)
	Remotes.RequestPickup.OnServerEvent:Connect(function(player, slot)
		if type(slot) == "number" then
			PlotService.pickup(player, slot)
		end
	end)
	Remotes.RequestFeed.OnServerEvent:Connect(function(player, arg)
		if type(arg) == "table" and type(arg.inv) == "number" then
			PlotService.feedFromInventory(player, arg.inv)
		elseif type(arg) == "number" then
			PlotService.feed(player, arg)
		end
	end)
	Remotes.GetFullState.OnServerInvoke = function(player)
		local profile = DataService.waitFor(player)
		if not profile then
			return nil
		end
		PlotService.pushState(player)
		return true
	end

	-- Renda passiva (1x/seg)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local profile = DataService.get(player)
				if profile then
					local cps = PlotService.coinsPerSecond(player)
					if cps > 0 then
						profile.coins += cps
						DataService.markDirty(player)
					end
					-- Auto-Feed pass: alimenta a comida mais fraca a cada 5s
					if profile.passes.AutoFeed and os.time() % 5 == 0 then
						local bestSlot: number? = nil
						local bestOrder = 99
						for key, food in profile.plot do
							local def = Config.FoodById[food.id]
							if def and Config.Rarities[def.rarity].order < bestOrder then
								bestOrder = Config.Rarities[def.rarity].order
								bestSlot = tonumber(key)
							end
						end
						if bestSlot then
							PlotService.feed(player, bestSlot)
						end
					end
					PlotService.pushState(player)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if foodModels[player] then
			for _, m in foodModels[player] do
				m:Destroy()
			end
			foodModels[player] = nil
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- ShopService — compra de Lunchboxes, rebirth, códigos promocionais, daily reward.
local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local GiantService = require(script.Parent.GiantService)
local StealService = require(script.Parent.StealService)

local ShopService = {}
local luckBonus = 0 -- alterado por EventService (Lucky Boxes)
local lastBuy: { [Player]: number } = {}

function ShopService.setLuckBonus(b: number)
	luckBonus = b
end

function ShopService.rollFood(box: Config.LunchboxDef, forceMinRarity: string?): Config.FoodDef
	local rarity = Util.weightedPick(box.weights, luckBonus)
	if forceMinRarity and Config.Rarities[rarity].order < Config.Rarities[forceMinRarity].order then
		rarity = forceMinRarity
	end
	local pool = {}
	for _, f in Config.Foods do
		if f.rarity == rarity then
			table.insert(pool, f)
		end
	end
	return pool[math.random(1, #pool)]
end

function ShopService.openBox(player: Player, boxId: string, free: boolean?, forceMinRarity: string?)
	local profile = DataService.get(player)
	local box = Config.LunchboxById[boxId]
	if not profile or not box then
		return
	end
	local now = os.clock()
	if (lastBuy[player] or 0) + 0.4 > now then
		return
	end
	lastBuy[player] = now
	if not free then
		if profile.coins < box.price then
			Remotes.Notify:FireClient(player, { text = "Moedas insuficientes!", color = Color3.fromRGB(255, 90, 90) })
			return
		end
		profile.coins -= box.price
	end
	profile.totalBoxes += 1
	local food = ShopService.rollFood(box, forceMinRarity)
	PlotService.giveFood(player, food.id)
	StealService.giveShield(player, Config.Steal.PurchaseShieldSec)
	Remotes.HatchResult:FireClient(player, { foodId = food.id, rarity = food.rarity, name = food.name, color = food.color })
	if Config.Rarities[food.rarity].order >= 5 then
		Remotes.Notify:FireAllClients({ text = player.DisplayName .. " encontrou " .. food.name .. " (" .. food.rarity .. ")!", color = Config.Rarities[food.rarity].color })
	end
	DataService.markDirty(player)
	PlotService.pushState(player)
end

function ShopService.rebirth(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if profile.level < Config.Rebirth.MinLevel then
		Remotes.Notify:FireClient(player, { text = "Rebirth exige Gigante nível " .. Config.Rebirth.MinLevel .. "!", color = Color3.fromRGB(255, 90, 90) })
		return
	end
	profile.rebirths += 1
	profile.level = 1
	profile.xp = 0
	profile.hunger = 60
	DataService.markDirty(player)
	GiantService.refresh(player)
	PlotService.pushState(player)
	Remotes.Notify:FireAllClients({ text = player.DisplayName .. " fez REBIRTH #" .. profile.rebirths .. "!", color = Color3.fromRGB(255, 120, 255) })
end

function ShopService.redeem(player: Player, code: string)
	local profile = DataService.get(player)
	if not profile or type(code) ~= "string" then
		return
	end
	code = string.upper(string.sub(code, 1, 20))
	local reward = Config.PromoCodes[code]
	if not reward then
		Remotes.Notify:FireClient(player, { text = "Código inválido.", color = Color3.fromRGB(255, 90, 90) })
		return
	end
	if profile.redeemedCodes[code] then
		Remotes.Notify:FireClient(player, { text = "Código já usado.", color = Color3.fromRGB(255, 90, 90) })
		return
	end
	profile.redeemedCodes[code] = true
	profile.coins += reward
	DataService.markDirty(player)
	PlotService.pushState(player)
	Remotes.Notify:FireClient(player, { text = "Código resgatado: +" .. Util.formatNumber(reward) .. " moedas!", color = Color3.fromRGB(80, 255, 120) })
end

function ShopService.claimDaily(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local now = os.time()
	local elapsed = now - profile.lastDaily
	if elapsed < 20 * 3600 then
		Remotes.Notify:FireClient(player, { text = "Volte amanhã para a próxima recompensa!", color = Color3.fromRGB(255, 200, 80) })
		return
	end
	if elapsed > 48 * 3600 then
		profile.dailyStreak = 0
	end
	profile.dailyStreak = math.min(profile.dailyStreak + 1, #Config.DailyRewards)
	profile.lastDaily = now
	local reward = Config.DailyRewards[profile.dailyStreak]
	profile.coins += reward
	if profile.dailyStreak == #Config.DailyRewards then
		ShopService.openBox(player, "epic", true)
		profile.dailyStreak = 0
	end
	DataService.markDirty(player)
	PlotService.pushState(player)
	Remotes.Notify:FireClient(player, { text = "Recompensa diária: +" .. Util.formatNumber(reward) .. " moedas!", color = Color3.fromRGB(80, 255, 120) })
end

function ShopService.buySpecies(player: Player, speciesId: string)
	local profile = DataService.get(player)
	local sp = Config.SpeciesById[speciesId]
	if not profile or not sp then
		return
	end
	if profile.ownedSpecies[speciesId] then
		GiantService.setSpecies(player, speciesId)
		PlotService.pushState(player)
		return
	end
	if sp.robux then
		Remotes.Notify:FireClient(player, { text = sp.name .. " é exclusivo de Game Pass.", color = Color3.fromRGB(255, 200, 80) })
		return
	end
	if profile.coins < sp.price then
		Remotes.Notify:FireClient(player, { text = "Faltam " .. Util.formatNumber(sp.price - profile.coins) .. " moedas para " .. sp.name .. ".", color = Color3.fromRGB(255, 90, 90) })
		return
	end
	profile.coins -= sp.price
	profile.ownedSpecies[speciesId] = true
	DataService.markDirty(player)
	GiantService.setSpecies(player, speciesId)
	PlotService.pushState(player)
	Remotes.Notify:FireAllClients({ text = player.DisplayName .. " desbloqueou o " .. sp.name .. " [" .. sp.rarityTag .. "]!", color = sp.color })
end

function ShopService.init()
	Remotes.RequestBuySpecies.OnServerEvent:Connect(function(player, id)
		if type(id) == "string" then
			ShopService.buySpecies(player, id)
		end
	end)
	Remotes.RequestEquipSpecies.OnServerEvent:Connect(function(player, id)
		local profile = DataService.get(player)
		if type(id) == "string" and profile and profile.ownedSpecies[id] then
			GiantService.setSpecies(player, id)
			PlotService.pushState(player)
		end
	end)
	GiantService.OnReturnBonus = function(player, _away)
		ShopService.openBox(player, Config.Decay.ReturnBonusBox, true, nil)
	end
	Remotes.RequestBuyBox.OnServerEvent:Connect(function(player, boxId)
		if type(boxId) == "string" then
			ShopService.openBox(player, boxId)
		end
	end)
	Remotes.RequestRebirth.OnServerEvent:Connect(ShopService.rebirth)
	Remotes.RequestRedeemCode.OnServerEvent:Connect(function(player, code)
		ShopService.redeem(player, code)
	end)
	Remotes.RequestClaimDaily.OnServerEvent:Connect(ShopService.claimDaily)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--!strict
-- StealService — roubo de comida entre bases, escudos, derrubar ladrão com o Bat.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Config = require(game.ReplicatedStorage.Shared.Config)
local Util = require(game.ReplicatedStorage.Shared.Util)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)
local PlotService = require(script.Parent.PlotService)

local StealService = {}

type Carry = { food: DataService.FoodInstance, from: Player, model: Model }
local carrying: { [Player]: Carry } = {}
local channeling: { [Player]: boolean } = {}

local function playerFromUserId(userId: number): Player?
	return Players:GetPlayerByUserId(userId)
end

function StealService.isShielded(player: Player): boolean
	local profile = DataService.get(player)
	return profile ~= nil and profile.shieldUntil > os.time()
end

function StealService.giveShield(player: Player, seconds: number)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	profile.shieldUntil = math.max(profile.shieldUntil, os.time() + seconds)
	local base = MapService.getBaseOf(player)
	if base then
		local old = base.model:FindFirstChild("ShieldFX")
		if old then
			old:Destroy()
		end
		local fx = Util.makePart({
			Name = "ShieldFX",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(Config.BaseSize * 1.2, Config.BaseSize * 1.2, Config.BaseSize * 1.2),
			CFrame = base.origin * CFrame.new(0, 2, 0),
			Color = Color3.fromRGB(80, 200, 255),
			Material = Enum.Material.ForceField,
			Transparency = 0.4,
			CanCollide = false,
			CanQuery = false,
			Parent = base.model,
		})
		task.delay(profile.shieldUntil - os.time(), function()
			if fx.Parent and not StealService.isShielded(player) then
				fx:Destroy()
			end
		end)
	end
	PlotService.pushState(player)
end

local function attachCarryVisual(thief: Player, def: Config.FoodDef): Model?
	local char = thief.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "CarriedFood"
	local p = Util.makePart({
		Name = "Body",
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Size = Vector3.new(2.5, 2.5, 2.5),
		Color = def.color,
		Material = Enum.Material.Neon,
		Parent = model,
	})
	p.Shape = Enum.PartType.Ball
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = p
	p.CFrame = head.CFrame * CFrame.new(0, 2.5, 0)
	weld.Parent = p
	Util.makeBillboard(p, "ROUBANDO: " .. def.name, UDim2.fromOffset(200, 40), Vector3.new(0, 2, 0), Color3.fromRGB(255, 80, 80))
	model.Parent = char
	return model
end

local function dropCarry(thief: Player, returnTo: boolean)
	local c = carrying[thief]
	if not c then
		return
	end
	carrying[thief] = nil
	if c.model then
		c.model:Destroy()
	end
	if returnTo and c.from.Parent then
		local profile = DataService.get(c.from)
		if profile then
			table.insert(profile.inventory, c.food)
			DataService.markDirty(c.from)
			PlotService.pushState(c.from)
			Remotes.Notify:FireClient(c.from, { text = "Você recuperou sua comida!", color = Color3.fromRGB(80, 255, 120) })
		end
	end
end

local function tryStartSteal(thief: Player, foodModel: Model)
	if carrying[thief] or channeling[thief] then
		return
	end
	local ownerId = foodModel:GetAttribute("OwnerUserId")
	local slot = foodModel:GetAttribute("SlotIndex")
	if type(ownerId) ~= "number" or type(slot) ~= "number" then
		return
	end
	local owner = playerFromUserId(ownerId)
	if not owner or owner == thief then
		return
	end
	if StealService.isShielded(owner) then
		Remotes.Notify:FireClient(thief, { text = "Esta base está protegida por um escudo!", color = Color3.fromRGB(80, 200, 255) })
		return
	end
	local foodId = foodModel:GetAttribute("FoodId")
	local def = Config.FoodById[foodId]
	if not def then
		return
	end

	channeling[thief] = true
	Remotes.StealAlert:FireClient(owner, { thiefName = thief.DisplayName, food = def.name })
	Remotes.Notify:FireClient(thief, { text = "Roubando " .. def.name .. "... fique parado 3s!", color = Color3.fromRGB(255, 200, 80) })

	local primary = foodModel.PrimaryPart
	local beam
	if primary then
		beam = Util.makePart({
			Name = "StealBeam",
			Size = Vector3.new(1.5, 40, 1.5),
			CFrame = primary.CFrame * CFrame.new(0, 20, 0),
			Color = Color3.fromRGB(255, 50, 50),
			Material = Enum.Material.Neon,
			Transparency = 0.3,
			CanCollide = false,
			Parent = foodModel,
		})
	end

	local startPos = thief.Character and thief.Character:GetPivot().Position
	local t0 = os.clock()
	local ok = true
	while os.clock() - t0 < Config.Steal.ChannelTime do
		task.wait(0.1)
		local char = thief.Character
		if not char or not char.Parent or not foodModel.Parent or not startPos then
			ok = false
			break
		end
		if (char:GetPivot().Position - startPos).Magnitude > 6 then
			ok = false
			break
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			ok = false
			break
		end
	end
	if beam then
		beam:Destroy()
	end
	channeling[thief] = nil
	if not ok then
		Remotes.Notify:FireClient(thief, { text = "Roubo cancelado.", color = Color3.fromRGB(255, 90, 90) })
		return
	end
	local food = PlotService.removeFromPlot(owner, slot)
	if not food then
		return
	end
	local visual = attachCarryVisual(thief, def)
	carrying[thief] = { food = food, from = owner, model = visual :: Model }
	Remotes.Notify:FireClient(thief, { text = "Pegou! Corra para sua base e toque no seu pátio.", color = Color3.fromRGB(80, 255, 120) })
	Remotes.Notify:FireClient(owner, { text = thief.DisplayName .. " ROUBOU seu " .. def.name .. "! Acerte-o com o bastão!", color = Color3.fromRGB(255, 60, 60) })
end

local function tryDeposit(thief: Player)
	local c = carrying[thief]
	if not c then
		return
	end
	local profile = DataService.get(thief)
	if not profile then
		return
	end
	carrying[thief] = nil
	if c.model then
		c.model:Destroy()
	end
	table.insert(profile.inventory, c.food)
	profile.totalSteals += 1
	DataService.markDirty(thief)
	PlotService.pushState(thief)
	local def = Config.FoodById[c.food.id]
	Remotes.Notify:FireClient(thief, { text = "Roubo concluído: " .. (def and def.name or "comida") .. " é sua!", color = Color3.fromRGB(80, 255, 120) })
end

local function giveBat(player: Player)
	local char = player.Character
	if not char then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or backpack:FindFirstChild("Bastão") then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = "Bastão"
	tool.RequiresHandle = true
	tool.ToolTip = "Bata em ladrões para derrubar a comida"
	local handle = Util.makePart({
		Name = "Handle",
		Anchored = false,
		CanCollide = false,
		Size = Vector3.new(0.6, 4, 0.6),
		Color = Color3.fromRGB(150, 90, 40),
		Material = Enum.Material.Wood,
		Parent = tool,
	})
	local lastHit = 0
	handle.Touched:Connect(function(hit)
		if os.clock() - lastHit < 0.8 then
			return
		end
		local target = Players:GetPlayerFromCharacter(hit.Parent)
		if not target or target == player then
			return
		end
		if not tool.Parent or tool.Parent ~= player.Character then
			return
		end
		lastHit = os.clock()
		if carrying[target] then
			dropCarry(target, true)
			Remotes.Notify:FireClient(target, { text = "Você foi atingido e derrubou a comida!", color = Color3.fromRGB(255, 90, 90) })
		end
		local root = hit.Parent:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local dir = (root.Position - handle.Position).Unit
			root.AssemblyLinearVelocity = dir * Config.Steal.KnockbackForce + Vector3.new(0, 30, 0)
		end
	end)
	tool.Parent = backpack
end

function StealService.init()
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			task.wait(0.5)
			giveBat(player)
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Died:Connect(function()
					dropCarry(player, true)
				end)
			end
			-- Depositar ao tocar no próprio pátio
			local root = char:WaitForChild("HumanoidRootPart", 5) :: BasePart?
			if root then
				root.Touched:Connect(function(hit)
					if not carrying[player] then
						return
					end
					local baseIndex = hit:GetAttribute("BaseIndex")
					if type(baseIndex) == "number" then
						local base = MapService.Bases[baseIndex]
						if base and base.owner == player then
							tryDeposit(player)
						end
					end
				end)
			end
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		dropCarry(player, true)
		channeling[player] = nil
	end)

	-- Cliques em comidas (ClickDetector criado pelo PlotService)
	Workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("ClickDetector") then
			local model = inst:FindFirstAncestorOfClass("Model")
			if model and model:GetAttribute("FoodId") then
				inst.MouseClick:Connect(function(clicker)
					local ownerId = model:GetAttribute("OwnerUserId")
					if ownerId == clicker.UserId then
						local slot = model:GetAttribute("SlotIndex")
						if type(slot) == "number" then
							PlotService.feed(clicker, slot)
						end
					else
						tryStartSteal(clicker, model)
					end
				end)
			end
		end
	end)
end

return StealService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
