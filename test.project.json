{
  "name": "FeedAGiant-Test",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" },
      "fwjelaa": { "$path": "src/vendor/shared" },
      "Remotes": { "$className": "Folder" },
      "Localization": { "$path": "src/localization" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/server" },
      "fwjelaa": { "$path": "src/vendor/server" },
      "FwjelaaTests": { "$path": "tests" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client" }
      },
      "$properties": { "CharacterWalkSpeed": 20 }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": { "FilteringEnabled": true },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [1200, 4, 1200],
          "Position": [0, -2, 0],
          "Color": [0.17, 0.62, 0.3],
          "Material": "Grass",
          "TopSurface": "Smooth"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "LightingStyle": "Soft",
        "GlobalShadows": true
      }
    },
    "SoundService": { "$className": "SoundService" },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": { "ScreenOrientation": "LandscapeSensor" }
    }
  }
}
