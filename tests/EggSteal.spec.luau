--!nonstrict
-- Specs do ROUBO DE OVO (09/11/2026, pedido do usuário: "mais leve do que roubar comida").
-- Mesmo código do EggService (GameLogic.eggStealAllowed / eggStealRefund).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameRules = require(ReplicatedStorage.Shared.GameRules)
local GameLogic = require(ServerScriptService.Server.GameLogic)

local NOW = 1794182400 + 12 * 3600 -- meio-dia de um dia qualquer
local DAY = NOW // 86400

return function()
	describe("Roubo de ovo: quando pode", function()
		it("pode roubar quando todas as regras deixam", function()
			local ok, why = GameLogic.eggStealAllowed(10, 2, 600, 0, 0, 0, NOW)
			expect(ok).to.equal(true)
			expect(why).to.equal(nil)
		end)
		it("jogador novo (nível < 5) nunca perde ovo", function()
			local ok, why = GameLogic.eggStealAllowed(4, 3, 600, 0, 0, 0, NOW)
			expect(ok).to.equal(false)
			expect(why).to.equal("newbie")
		end)
		it("nunca o último ovo chocando", function()
			local ok, why = GameLogic.eggStealAllowed(10, 1, 600, 0, 0, 0, NOW)
			expect(ok).to.equal(false)
			expect(why).to.equal("last")
		end)
		it("ovo a menos de 1 min de chocar fica seguro", function()
			local ok, why = GameLogic.eggStealAllowed(10, 3, 59, 0, 0, 0, NOW)
			expect(ok).to.equal(false)
			expect(why).to.equal("hatching")
		end)
		it("vítima fica 20 min protegida depois de perder um ovo", function()
			local ok, why = GameLogic.eggStealAllowed(10, 3, 600, NOW - 1199, 0, 0, NOW)
			expect(ok).to.equal(false)
			expect(why).to.equal("immune")
			local ok2 = GameLogic.eggStealAllowed(10, 3, 600, NOW - GameRules.EggSteal.VictimImmuneSeconds, 0, 0, NOW)
			expect(ok2).to.equal(true)
		end)
		it("ladrão faz no máximo 2 por dia; o dia seguinte zera", function()
			local ok, why = GameLogic.eggStealAllowed(10, 3, 600, 0, DAY, 2, NOW)
			expect(ok).to.equal(false)
			expect(why).to.equal("daily")
			local ok2 = GameLogic.eggStealAllowed(10, 3, 600, 0, DAY - 1, 2, NOW)
			expect(ok2).to.equal(true)
		end)
	end)

	describe("Roubo de ovo: mais leve que o de comida", function()
		it("canal maior e limite diário menor que o roubo de comida", function()
			expect(GameRules.EggSteal.PerDay < GameRules.StealLimits.MaxPerDay).to.equal(true)
			expect(GameRules.EggSteal.ChannelSeconds >= 5).to.equal(true)
		end)
		it("a vítima recebe consolo: 25% do preço (ou valor fixo)", function()
			expect(GameLogic.eggStealRefund(3000)).to.equal(750)
			expect(GameLogic.eggStealRefund(nil)).to.equal(GameRules.EggSteal.RefundFallback)
			expect(GameLogic.eggStealRefund(0)).to.equal(GameRules.EggSteal.RefundFallback)
		end)
	end)
end
