--!nonstrict
local Rules = require(game.ReplicatedStorage.Shared.RebuildV2.StageRules)

return function()
	describe("V3: crescimento sem inflacao por alimento", function()
		it("mantem a escala dentro de tres estagios", function()
			local baby, babyName, babyScale = Rules.stage(1)
			expect(baby).to.equal("baby")
			expect(babyName).to.equal("Bebê")
			local _, _, nineScale = Rules.stage(9)
			expect(babyScale).to.equal(nineScale)
			local young, youngName, youngScale = Rules.stage(10)
			expect(young).to.equal("young")
			expect(youngName).to.equal("Jovem")
			expect(Rules.stage(29)).to.equal("young")
			local adult, adultName, adultScale = Rules.stage(30)
			expect(adult).to.equal("colossus")
			expect(adultName).to.equal("Colosso")
			expect(Rules.stage(999999)).to.equal("colossus")
			expect(babyScale < youngScale).to.equal(true)
			expect(youngScale < adultScale).to.equal(true)
			expect(adultScale <= 2.2).to.equal(true)
		end)
		it("estilo novo nao modifica stage original", function()
			local old = { name = "LEGADO", minLevel = 1, teeth = false, mouthWidth = 0.5 }
			local new = Rules.style(30, old)
			expect(old.name).to.equal("LEGADO")
			expect(new.name).to.equal("Colosso")
			expect(new.teeth).to.equal(true)
		end)
	end)
end
