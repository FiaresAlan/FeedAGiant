--!nonstrict
-- Specs V2 de regras puras; rodar no Studio: require(game.ServerScriptService.FwjelaaTests.Runner)()
local Shared = game:GetService("ReplicatedStorage").Shared
local Catalog = require(Shared.RebuildV2.RecipeCatalog)
local RunRules = require(Shared.RebuildV2.RunRules)
local Config = require(Shared.Config)
local Features = require(Shared.Features)

return function()
	describe("V2: feature flag segura", function()
		it("V2 nao entra silenciosamente no jogo antigo", function()
			expect(type(Features.flags.RebuildV2)).to.equal("boolean")
		end)
	end)

	describe("V2: seis receitas deterministicas", function()
		it("tem seis receitas unicas com todos os resultados definidos", function()
			expect(#Catalog.Recipes).to.equal(6)
			for _, recipe in Catalog.Recipes do
				expect(Catalog.ById[recipe.id]).to.be.ok()
				expect(Config.FoodById[recipe.resultId]).to.be.ok()
				expect(Config.Rarities[recipe.rarity]).to.be.ok()
				expect(#recipe.ingredients).to.equal(2)
				expect(recipe.seconds > 0).to.equal(true)
			end
		end)
		it("busca independente da ordem dos ingredientes", function()
			expect(Catalog.fromIngredients("bread", "cheese").id).to.equal("toast_cheese")
			expect(Catalog.fromIngredients("cheese", "bread").id).to.equal("toast_cheese")
			expect(Catalog.fromIngredients("colossal_fruit", "honey").id).to.equal("fruit_banquet")
			expect(Catalog.fromIngredients("honey", "colossal_fruit").id).to.equal("fruit_banquet")
			expect(Catalog.fromIngredients("apple", "pepper_rare")).to.equal(nil)
		end)
		it("tem duracoes iniciais deliberadamente curtas", function()
			expect(Catalog.ById.toast_cheese.seconds).to.equal(12)
			expect(Catalog.ById.toast_apple.seconds).to.equal(15)
			expect(Catalog.ById.stew.seconds).to.equal(35)
			expect(Catalog.ById.caramel_apple.seconds).to.equal(90)
			expect(Catalog.ById.spicy_meat.seconds).to.equal(720)
			expect(Catalog.ById.fruit_banquet.seconds).to.equal(1800)
		end)
		it("nao revela a composicao de receitas fechadas", function()
			local locked = Catalog.publicRecipes({})
			expect(locked[1].discovered).to.equal(false)
			expect(locked[1].ingredients).to.equal(nil)
			expect(locked[1].resultId).to.equal(nil)
			local open = Catalog.publicRecipes({ toast_cheese = true })
			expect(open[1].discovered).to.equal(true)
			expect(open[1].ingredients[1]).to.equal("bread")
		end)
		it("nao modifica probabilidades existentes de caixas", function()
			local ids = {}
			for _, item in Config.Foods do ids[item.id] = true end
			for id in Catalog.Items do
				expect(Config.FoodById[id]).to.be.ok()
				expect(ids[id]).to.equal(nil)
			end
		end)
	end)

	describe("V2: forca, velocidade e stamina", function()
		it("nao transforma progresso em vantagem infinita", function()
			expect(RunRules.progressionFactor(1)).to.be.near(1)
			expect(RunRules.progressionFactor(99999)).to.be.near(1.08)
			expect(RunRules.speed(999, "light", true, "fire_starter", true) <= 31).to.equal(true)
		end)
		it("cargas pesadas atrapalham mais que as leves", function()
			expect(RunRules.speed(10, "heavy", false, "stone_starter", false) <
				RunRules.speed(10, "light", false, "stone_starter", false)).to.equal(true)
		end)
		it("poder de pedra ajuda a carregar peso", function()
			local normal = RunRules.speed(10, "heavy", false, "stone_starter", false)
			local boosted = RunRules.speed(10, "heavy", false, "stone_starter", true)
			expect(boosted > normal).to.equal(true)
		end)
		it("boost de fogo melhora arrancada sem ultrapassar limite de velocidade", function()
			local normal = RunRules.speed(5, "light", false, "fire_starter", false)
			local boosted = RunRules.speed(5, "light", false, "fire_starter", true)
			expect(boosted > normal).to.equal(true)
			expect(boosted <= 31).to.equal(true)
		end)
		it("fôlego esgota e se recupera dentro de limites", function()
			expect(RunRules.stamina(10, 1, true)).to.equal(0)
			expect(RunRules.stamina(100, 1, false)).to.equal(100)
			expect(RunRules.stamina(0, 1, false)).to.equal(14)
		end)
	end)
end
